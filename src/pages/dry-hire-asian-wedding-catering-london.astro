---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';

import galleryTable from '@/assets/images/gallery-wedding-table.jpg';
import homeServiceCatering from '@/assets/images/home-service-catering.jpg';
import headerStage from '@/assets/images/header-stage-decor.png';

import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Asian Wedding Catering', href: '/services/asian-wedding-catering' },
  { name: 'Dry-Hire, Hotel & Marquee Catering London' },
];

const quickFacts = [
  { label: 'Venue Types', value: 'Dry-Hire Estates, Luxury Hotels, Historic Barns, Country Houses & Marquees' },
  { label: 'Starting Price', value: 'From £25pp (Silver) • £40pp (Gold) • Platinum All-Inclusive from £17,500' },
  { label: 'Guest Capacity', value: '50 to 1,000+ guests with full mobile finishing kitchen logistics' },
  { label: 'Equipment Included', value: 'Fine crockery, cutlery, glassware, chafing stations, hot-boxes & linen options' },
  { label: 'Venue Compliance', value: 'Public liability insurance, food hygiene documentation & full RAMS provided' },
  { label: 'Areas Covered', value: 'Central & Greater London, Essex, Kent & Surrounding Home Counties' },
];

const dryHireChecklist = [
  {
    title: 'Mobile Finishing Kitchens & Insulated Fleet',
    detail:
      'Many historic London estates, barns, and garden marquees offer only basic prep space. We bring commercial hot-holding units, mobile finishing equipment, and insulated transport so every biryani, kebab, and curry reaches the table steaming hot.',
  },
  {
    title: 'Complete Crockery, Cutlery, Glassware & Serviceware',
    detail:
      'No juggling separate hire companies. Our packages cover matching porcelain plates, polished cutlery, glassware (Gold & Platinum), chafing displays, serving platters, and full post-event wash-up and clear-down.',
  },
  {
    title: 'Venue Documentation, Insurance & Site Walkthroughs',
    detail:
      'Hotels and heritage dry-hire venues require thorough paperwork. We liaise directly with your venue coordinator ahead of time to supply food safety records, allergen matrices, risk assessments, and load-in schedules.',
  },
  {
    title: 'One Team for Catering & Floral Stage Decor',
    detail:
      'Dry-hire spaces often have tight turnaround windows. Having Salwah Events manage both your HMC-certified Halal banquet and bespoke stage styling keeps rigging, table laying, and dinner service running on one shared timeline.',
  },
];

const faqs: FaqItem[] = [
  {
    question: 'What is dry-hire Asian wedding catering in London?',
    answer:
      'Dry-hire means you hire a luxury venue, hotel ballroom, manor house, or marquee space only, and bring in your own approved HMC-certified Halal Asian caterer. Salwah Events supplies all food, mobile finishing equipment, crockery, cutlery, glassware, uniformed waiting staff, and clear-down.',
  },
  {
    question: 'Can you cater in venues or garden marquees with no on-site kitchen?',
    answer:
      'Yes. Our mobile catering team regularly serves 50 to 800+ guest weddings in marquees, historic barns, and country estates across London, Essex, and Kent using commercial insulated hot-boxes and self-contained finishing setups.',
  },
  {
    question: 'Do you handle direct communication with our hotel or venue manager?',
    answer:
      'Yes — once booked, your Salwah coordinator joins your pre-event site visit, confirms load-in and kitchen access timings, submits required insurance and food hygiene documents, and oversees full post-event kitchen clearance.',
  },
  {
    question: 'Can we choose plated fine dining or family-style table service at a dry-hire venue?',
    answer:
      'Absolutely. Choose between formal plated table service, generous family-style sharing platters served directly to each round table, or grand multi-line chafing buffets.',
  },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildServiceSchema({
    name: 'Dry-Hire, Hotel & Marquee Asian Wedding Catering London',
    serviceType: 'Dry-Hire Halal Wedding Catering & Venue Logistics',
    description:
      'Full-service HMC-certified Halal dry-hire Asian wedding catering for London hotels, historic estates, barns, and marquees — including mobile finishing kitchens, crockery, staff & stage decor from £25pp.',
    url: '/dry-hire-asian-wedding-catering-london',
    areaServed: ['Central London', 'Greater London', 'East London', 'North London', 'West London', 'Essex', 'Kent'],
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="Dry-Hire Asian Wedding Caterers London | Hotels & Marquees From £25pp | Salwah Events"
  description="Full-service HMC-certified Halal dry-hire Asian wedding catering for London hotels, estates & marquees from £25pp. Mobile kitchens, fine crockery, uniformed staff & stage decor."
  canonicalPath="/dry-hire-asian-wedding-catering-london"
  schemas={schemas}
>
  <PageHero
    eyebrow="Hotels • Country Estates • Marquees • Historic Halls"
    title="Dry-Hire Asian Wedding"
    highlight="Catering London"
    subtitle="Bringing HMC-certified Halal Bengali, Pakistani, and Indian wedding banquets into London's premier dry-hire venues, hotels, and garden marquees — complete with mobile finishing setups, crockery, uniformed staff, and bespoke stage styling from £25pp."
    image={galleryTable}
    imageAlt="Luxury candlelit dry-hire wedding reception table styled by Salwah Events in London"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="#quote-form"
    primaryCtaLabel="Discuss My Dry-Hire Venue"
  />

  <section class="py-14 sm:py-16 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-10">
          <QuickFactsBox
            heading="Dry-Hire, Hotel & Marquee Catering — At a Glance"
            summary="Full-service HMC-certified Halal wedding catering tailored for dry-hire hotels, heritage estates, country barns, and private marquees across London, Essex, and Kent."
            facts={quickFacts}
          />

          <div class="space-y-5">
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">
              Every Detail Handled — <span class="gold-gradient-text italic font-semibold">From Setup to Clear-Down</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {
                dryHireChecklist.map((item) => (
                  <div class="luxury-card rounded-2xl p-6 space-y-2.5">
                    <h3 class="font-serif text-xl font-bold text-salwah-gold">{item.title}</h3>
                    <p class="text-sm text-gray-300 leading-relaxed">{item.detail}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden border border-salwah-gold/25">
              <Picture
                src={homeServiceCatering}
                alt="Uniformed Halal catering team preparing dishes for a dry-hire London wedding"
                widths={[480, 800]}
                formats={['webp']}
                fallbackFormat="webp"
                quality={80}
                loading="lazy"
                class="h-56 w-full object-cover"
              />
            </div>
            <div class="rounded-2xl overflow-hidden border border-salwah-gold/25">
              <Picture
                src={headerStage}
                alt="Bespoke ballroom stage decoration installed inside a dry-hire wedding venue"
                widths={[480, 800]}
                formats={['webp']}
                fallbackFormat="webp"
                quality={80}
                loading="lazy"
                class="h-56 w-full object-cover"
              />
            </div>
          </div>

          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold">
            <h2>Grand Hospitality in Any Venue</h2>
            <p>
              Choosing a dry-hire venue gives you the freedom to celebrate in a historic hall, hotel ballroom,
              or countryside estate without compromising on authentic HMC-certified Halal South Asian food.
              Salwah Events handles every operational detail behind the scenes — from venue paperwork and
              mobile kitchen setup to punctual, warm service for every table.
            </p>
            <p>
              Browse our <a href="/services/venues-locations">Partner Venues Directory</a>, compare{' '}
              <a href="/packages">Silver, Gold &amp; Platinum Packages</a>, or explore our regional guides for{' '}
              <a href="/halal-wedding-catering-essex-kent">Essex &amp; Kent Estates</a> and{' '}
              <a href="/halal-wedding-catering-north-west-london">North &amp; West London</a>.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-5 lg:sticky lg:top-28 space-y-6" id="quote-form">
          <QuoteForm
            client:visible
            variant="compact"
            sourcePage="Dry-Hire Catering LP"
            defaultService="Full Event Management"
            heading="Plan Your Dry-Hire Wedding"
            subheading="Share your venue name, date & guest count — we'll handle logistics, menus & stage styling."
          />
        </aside>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} heading="Dry-Hire &amp; Marquee Catering FAQs" />
  <CtaBanner
    title="Booked a Dry-Hire Venue"
    highlight="or Marquee?"
    primaryHref="#quote-form"
    primaryLabel="Request a Dry-Hire Proposal"
  />
</BaseLayout>
