---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';

import headerPlanning from '@/assets/images/header-event-planning.png';
import planningDetail from '@/assets/images/event-planning-detail.jpg';

import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Event Management & Planning' },
];

const quickFacts = [
  { label: 'Planning Tiers', value: 'Full Wedding Planning, Partial Coordination & On-the-Day Management' },
  { label: 'Events Managed', value: 'Multi-day Nikah, Mehndi / Gaye Holud, Baraat, Walima & Corporate Galas' },
  { label: 'Guest Scale', value: '50 to 1,000+ guests across London, Essex & Kent venues' },
  { label: 'In-House Synergy', value: 'Direct coordination with our HMC Halal catering & stage decor teams' },
  { label: 'Deliverables', value: 'Master run-sheet, vendor briefings, budget tracking & floor direction' },
  { label: 'All-Inclusive Option', value: 'Included in our Platinum Package starting from £17,500 (200 guests)' },
];

const faqs: FaqItem[] = [
  {
    question: 'What does your full Asian wedding planning service include?',
    answer:
      'Our full event management covers initial concept design, budget tracking, venue sourcing, supplier coordination (photographers, videographers, nasheed/DJ artists, bridal transport), minute-by-minute run-sheets, and dedicated on-the-day direction from setup through rukhsati.',
  },
  {
    question: 'We have already booked our venue and some suppliers — can you still manage our day?',
    answer:
      'Yes! We offer partial planning and on-the-day coordination where we step in, confirm timings with every supplier you have booked, and run the floor calmly so your family can simply enjoy the occasion.',
  },
  {
    question: 'Why hire a dedicated Asian wedding planner in London?',
    answer:
      'South Asian weddings often span multiple days, 300–1,000+ guests, religious timings (Nikah, Maghrib prayer breaks), and complex dining turnarounds. An experienced Asian wedding coordinator keeps caterers, decorators, Imams, and photographers synchronised without stressing your parents.',
  },
  {
    question: 'Can we bundle event management with Halal catering and stage decor?',
    answer:
      'Yes! Our Platinum Package (from £17,500 for 200 guests) bundles Gold-tier 100% HMC Halal catering, luxury wedding stage decoration, lighting, centrepieces, and a dedicated event manager under one contract.',
  },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildServiceSchema({
    name: 'Asian Wedding Event Management & Planning London',
    serviceType: 'Asian Wedding Planning & Event Management',
    description:
      'Full Asian wedding planning, multi-day coordination, vendor sourcing, and on-the-day event management across Greater London, Essex, and Kent.',
    url: '/services/event-management-planning',
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="Asian Wedding Planner London | Full Event Management | Salwah Events"
  description="Calm, organised Asian wedding planning and full event management in London, Essex & Kent. Master run-sheets, venue sourcing, supplier coordination, and on-the-day floor direction."
  canonicalPath="/services/event-management-planning"
  schemas={schemas}
>
  <PageHero
    eyebrow="Calm, Organised Event Direction · London, Essex & Kent"
    title="Event Management"
    highlight="& Wedding Planning"
    subtitle="From master timelines and supplier coordination to dedicated on-the-day floor direction — let our experienced Asian wedding planners carry the logistics while you stay present with your family."
    image={headerPlanning}
    imageAlt="Asian wedding event management and coordination in London by Salwah Events"
    breadcrumbs={breadcrumbs}
    trustBadges={[
      { label: 'Full & On-the-Day Planning', accent: true },
      { label: '50–1,000+ Guests', accent: false },
      { label: 'Greater London, Essex & Kent', accent: false },
      { label: '5.0★ Google Rating', accent: true },
    ]}
    primaryCtaHref="#quote-form"
    primaryCtaLabel="Book Planning Consultation"
  />

  <section class="py-14 sm:py-16 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-8">
          <QuickFactsBox
            heading="Event Management & Planning — At a Glance"
            summary="Salwah Events coordinates every operational detail of Bengali, Pakistani, Indian, and corporate events across London, Essex, and Kent — ensuring catering, decor, photography, and guest hospitality run like clockwork."
            facts={quickFacts}
          />

          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold">
            <h2>A Stress-Free Day for Couples &amp; Parents</h2>
            <p>
              Planning a multi-event Asian wedding often turns parents and siblings into unpaid project
              managers on the very day they should be welcoming guests. Our{' '}
              <strong>full event management</strong> team runs the schedule behind the scenes —
              coordinating load-ins, venue timings, supplier arrivals, and dinner service so your
              family can stay present for every milestone.
            </p>
          </div>

          <div class="rounded-2xl overflow-hidden border border-salwah-gold/20">
            <Picture
              src={planningDetail}
              alt="Candlelit sweetheart top table draped in white orchids and roses styled by Salwah Events in London"
              widths={[480, 800]}
              sizes="(max-width: 1024px) 100vw, 58vw"
              formats={['webp']} fallbackFormat="webp" quality={78}
              loading="lazy"
              class="w-full h-72 sm:h-80 object-cover"
            />
          </div>

          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold">
            <h2>What Our Wedding Planners Manage</h2>
            <ul>
              <li>
                <strong>Minute-by-Minute Master Run-Sheet:</strong> Synchronising couple entrances,
                Nikah timings, prayer breaks, hot{' '}
                <a href="/services/asian-wedding-catering">Halal catering service</a>, speeches,
                cake cutting, and rukhsati.
              </li>
              <li>
                <strong>Trusted Supplier Network:</strong> Coordinating photographers, videographers,
                makeup artists, DJs/nasheed artists, luxury bridal cars, and{' '}
                <a href="/services/wedding-stage-decoration">stage decorators</a>.
              </li>
              <li>
                <strong>Venue Liaison &amp; Logistics:</strong> Managing dry-hire access windows,
                kitchen checks, seating layouts, and breakdown across{' '}
                <a href="/services/venues-locations">London, Essex &amp; Kent venues</a>.
              </li>
              <li>
                <strong>Free Planning Suite:</strong> Start mapping your event right now with our{' '}
                <a href="/resources">14 free online wedding planning tools</a>.
              </li>
            </ul>
          </div>
        </div>

        <aside class="lg:col-span-5 lg:sticky lg:top-28" id="quote-form">
          <QuoteForm
            client:visible
            variant="compact"
            sourcePage="Event Management LP"
            defaultService="Full Event Planning"
            heading="Plan Your Event With Us"
            subheading="Tell us your date & guest count to discuss full planning, on-the-day direction, or Platinum packages."
            notesLabel="Event Functions, Venue & Planning Notes (Optional)"
            notesPlaceholder="e.g. Same-day Nikah & Walima, 350 guests, City Pavilion, on-the-day coordination..."
            submitLabel="Book Planning Consultation"
          />
        </aside>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <CtaBanner
    title="Want Parents & Family"
    highlight="Free to Enjoy Every Moment?"
    subtitle="Tell us your event dates, venue, and what suppliers you already have booked. We will put together a clear planning or all-inclusive Platinum proposal."
    primaryHref="#quote-form"
    primaryLabel="Book a Free Consultation"
  />
</BaseLayout>
