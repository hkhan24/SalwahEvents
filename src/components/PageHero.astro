---
import { Picture } from 'astro:assets';
import TrustBadges, { type TrustBadgeItem } from '@/components/TrustBadges.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { BreadcrumbItem } from '@/lib/schema';
import { SITE } from '@/data/site';

interface Props {
  title: string;
  highlight?: string;
  subtitle: string;
  image?: ImageMetadata;
  imageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
  showTrustBadges?: boolean;
  trustBadges?: TrustBadgeItem[];
  showCtas?: boolean;
  primaryCtaHref?: string;
  primaryCtaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaLabel?: string;
  eyebrow?: string;
}

const {
  title,
  highlight,
  subtitle,
  image,
  imageAlt = 'Salwah Events and Catering luxury Asian wedding service in London',
  breadcrumbs,
  showTrustBadges = true,
  trustBadges,
  showCtas = true,
  primaryCtaHref = '#quote-form',
  primaryCtaLabel = 'Check Date & Pricing',
  secondaryCtaHref = SITE.whatsappHref,
  secondaryCtaLabel = 'WhatsApp Us',
  eyebrow,
} = Astro.props;

const isExternalSecondary = secondaryCtaHref.startsWith('http');
const isWhatsAppSecondary = secondaryCtaHref.includes('wa.me') || secondaryCtaHref.includes('whatsapp.com');
---

<section class="relative overflow-hidden bg-salwah-black border-b border-salwah-gold/25">
  {
    image && (
      <div class="absolute inset-0 z-0">
        <Picture
          src={image}
          alt={imageAlt}
          widths={[640, 1280]}
          sizes="100vw"
          formats={['webp']}
          fallbackFormat="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="h-full w-full object-cover object-center opacity-60 scale-[1.01]"
        />
        <!-- Directional cinema scrim keeps photography rich on the right while preserving crisp text contrast on the left -->
        <div class="absolute inset-0 bg-gradient-to-r from-salwah-black/92 via-salwah-black/72 to-salwah-black/35" />
        <div class="absolute inset-0 bg-gradient-to-t from-salwah-black via-transparent to-salwah-black/45" />
      </div>
    )
  }

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 sm:pt-16 sm:pb-22">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    )}

    <div class="max-w-4xl">
      {eyebrow && (
        <p class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold uppercase tracking-[0.22em] text-salwah-gold mb-3.5">
          <span class="h-px w-6 bg-salwah-gold/70" aria-hidden="true" />
          {eyebrow}
        </p>
      )}

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.08]">
        {title}{highlight && (<>{' '}<span class="gold-gradient-text italic font-semibold">{highlight}</span></>)}
      </h1>

      <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-gray-100/90 max-w-3xl leading-relaxed">
        {subtitle}
      </p>

      {showTrustBadges && (
        <div class="mt-6">
          <TrustBadges align="left" compact customBadges={trustBadges} />
        </div>
      )}

      {showCtas && (
        <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
          <a
            href={primaryCtaHref}
            class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-sm sm:text-base font-bold whitespace-nowrap"
          >
            {primaryCtaLabel}
          </a>
          <a
            href={secondaryCtaHref}
            target={isExternalSecondary ? '_blank' : undefined}
            rel={isExternalSecondary ? 'noopener noreferrer' : undefined}
            class={`${
              isWhatsAppSecondary ? 'btn-luxury-whatsapp' : 'btn-luxury-outline'
            } inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-sm sm:text-base font-semibold whitespace-nowrap`}
          >
            {isWhatsAppSecondary && (
              <svg class="h-4 w-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
              </svg>
            )}
            <span>{secondaryCtaLabel}</span>
          </a>
          <a
            href={SITE.phoneHref}
            class="btn-luxury-outline inline-flex items-center justify-center rounded-xl px-5 py-3.5 text-sm sm:text-base font-semibold whitespace-nowrap"
          >
            Call {SITE.phoneDisplay}
          </a>
        </div>
      )}
    </div>
  </div>
</section>
