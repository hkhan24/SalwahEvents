---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';

import heroImg from '@/assets/images/header-asian-catering.png';
import menuBiryani from '@/assets/images/menu-biryani.png';
import {
  buildBlogPostingSchema,
  buildBreadcrumbSchema,
  buildFaqSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const url = '/blog/asian-wedding-catering-cost-london-2026-guide';
const title = 'Asian Wedding Catering Costs in London: Complete Price Guide (From £25pp)';
const description =
  'How much does Halal Asian wedding catering cost in London? Real per-person figures for 100, 200, 350, 500 & 800 guests, Silver (£25pp) vs Gold (£40pp) vs Platinum inclusions, and costs to watch for.';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: 'Asian Wedding Catering Cost Guide' },
];

const faqs: FaqItem[] = [
  {
    question: 'What is the average cost per head for Halal Asian wedding catering in London?',
    answer:
      'In London, Salwah Events Halal Asian wedding packages start from £25 per person for the Silver Package (3 starters, 4 mains, pilau & plain rice or naan, 1 dessert, crockery, and staff) and £40 per person for the Gold Package (adding welcome drinks, canapés, 4 starters including fish, 4 premium mains, 2 desserts, glassware, and a floor supervisor). All-inclusive Platinum catering and luxury stage decor starts from £17,500 for 200 guests.',
  },
  {
    question: 'How much does catering cost for a 300-guest Asian wedding in London?',
    answer:
      'For 300 guests, expect approximately £7,500 on our £25pp Silver Package or £12,000 on our £40pp Gold Package (including welcome drinks, canapés, crockery, glassware, and uniformed staff), before any optional stage decoration or live dessert/paan stall.',
  },
  {
    question: 'Does Asian wedding catering price include crockery, cutlery, and waiting staff?',
    answer:
      'With Salwah Events, yes — our Silver, Gold, and Platinum packages all include crockery, cutlery, and professional waiting staff, and Gold/Platinum add full glassware and a dedicated floor supervisor.',
  },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildBlogPostingSchema({ title, description, url, publishedIso: '2026-02-10' }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="Asian Wedding Catering Costs London | Price Guide From £25pp | Salwah Events"
  description={description}
  canonicalPath={url}
  ogType="article"
  schemas={schemas}
>
  <PageHero
    eyebrow="Transparent Pricing Guide • 6 Min Read"
    title="Asian Wedding Catering Costs"
    highlight="in London (From £25pp)"
    subtitle="Real per-head figures from 100 to 800 guests, what is included in Silver (£25pp), Gold (£40pp) & Platinum tiers, and five hidden venue catering costs to check before you sign."
    image={heroImg}
    imageAlt="Uniformed catering servers presenting piping-hot copper bowls of biryani and curry to guests at a candlelit London Asian wedding banquet"
    breadcrumbs={breadcrumbs}
    showTrustBadges={false}
    showCtas={false}
  />

  <article class="py-14 sm:py-20 bg-salwah-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-invert prose-lg prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold text-gray-300">
      <p class="lead text-gray-200">
        One of the first questions couples and parents ask when planning a Bengali, Pakistani, or Indian
        wedding is straightforward: <strong>how much does Halal Asian wedding catering actually cost in London?</strong>{' '}
        Because too many suppliers leave pricing vague until after a sales call, here are our honest, real-world
        UK figures so you can plan your budget with confidence.
      </p>

      <h2>Clear Per-Head Wedding Catering Prices in London</h2>
      <ul>
        <li>
          <strong>Silver Package (£25 per person):</strong> Great value for Nikah lunches, Mehndi nights,
          Aqiqahs, and classic family receptions — includes 3 starters, salad &amp; chutneys, 4 HMC-certified
          Halal mains (chicken, lamb, vegetable, and daal), pilau rice &amp; plain rice or naan, 1 dessert,
          crockery, cutlery, and professional waiting staff.
        </li>
        <li>
          <strong>Gold Package (£40 per person — Most Popular):</strong> Built for full-scale wedding
          receptions and Walimas — adds welcome drinks, canapés, 4 starters (chicken, lamb, fish, and
          vegetable), 4 premium mains (chicken, lamb, prawn, and daal or vegetable), biryani or rice &amp;
          breads, 2 desserts, full glassware, and an experienced floor supervisor.
        </li>
        <li>
          <strong>Platinum Package (From £17,500 for 200 guests):</strong> Combines everything in the Gold
          Package with bespoke <a href="/services/wedding-stage-decoration">luxury wedding stage decoration</a>,
          venue lighting, table centrepieces, a live dessert or paan stall, and full event management with a
          dedicated event manager.
        </li>
      </ul>

      <h2>Sample Catering Budget by Guest Count</h2>
      <div class="not-prose my-6 overflow-x-auto rounded-2xl border border-salwah-gold/25 bg-[#0f1119] p-4">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-salwah-gold/30 text-salwah-gold font-serif">
              <th class="py-3 px-3">Guest Count</th>
              <th class="py-3 px-3">Silver (£25pp)</th>
              <th class="py-3 px-3">Gold (£40pp)</th>
              <th class="py-3 px-3">Typical Celebration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10 text-gray-200">
            <tr>
              <td class="py-3 px-3 font-semibold">100 Guests</td>
              <td class="py-3 px-3">£2,500</td>
              <td class="py-3 px-3">£4,000</td>
              <td class="py-3 px-3 text-gray-400">Intimate Nikah / Aqiqah / Mehndi</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-semibold">200 Guests</td>
              <td class="py-3 px-3">£5,000</td>
              <td class="py-3 px-3">£8,000</td>
              <td class="py-3 px-3 text-gray-400">Nikah &amp; Walima / Reception</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-semibold">350 Guests</td>
              <td class="py-3 px-3">£8,750</td>
              <td class="py-3 px-3">£14,000</td>
              <td class="py-3 px-3 text-gray-400">Classic East London Wedding</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-semibold">500 Guests</td>
              <td class="py-3 px-3">£12,500</td>
              <td class="py-3 px-3">£20,000</td>
              <td class="py-3 px-3 text-gray-400">Grand Ballroom Walima</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-semibold">800 Guests</td>
              <td class="py-3 px-3">£20,000</td>
              <td class="py-3 px-3">£32,000</td>
              <td class="py-3 px-3 text-gray-400">Landmark Venue Celebration</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="not-prose my-8 rounded-2xl overflow-hidden border border-salwah-gold/25">
        <Picture
          src={menuBiryani}
          alt="Freshly cooked saffron Lamb Kacchi Biryani prepared for London Asian weddings"
          widths={[480, 800]}
          formats={['webp']}
          fallbackFormat="webp"
          quality={80}
          loading="lazy"
          class="w-full h-72 object-cover"
        />
      </div>

      <h2>5 Hidden Costs to Watch Out For When Comparing Caterers</h2>
      <ol>
        <li>
          <strong>Crockery, Cutlery &amp; Glassware Hire:</strong> Some cut-price per-head quotes exclude
          plates, forks, glassware, and clearing staff — easily adding £5–£9 per guest later.
        </li>
        <li>
          <strong>Venue Kitchen Access Fees:</strong> Dry-hire hotels and estates sometimes charge external
          kitchen access fees. See our{' '}
          <a href="/dry-hire-asian-wedding-catering-london">Dry-Hire Wedding Catering Guide</a> for what to ask
          before signing your venue contract.
        </li>
        <li>
          <strong>Double Transport &amp; Turnaround Costs:</strong> Hiring catering and{' '}
          <a href="/services/wedding-stage-decoration">stage decoration</a> from one coordinated team avoids
          clashing van schedules and separate setup charges.
        </li>
        <li>
          <strong>Live Stalls &amp; Menu Upgrades:</strong> Live chaat stations, king prawn dishes, and dessert
          or paan stalls create great atmosphere — make sure they are clearly itemised upfront.
        </li>
        <li>
          <strong>VAT &amp; Service Charge Clarity:</strong> Always confirm whether a written quotation is
          inclusive or exclusive of VAT before comparing two caterers side by side.
        </li>
      </ol>

      <h2>Estimate Your Own Wedding Budget</h2>
      <p>
        Ready to run your own numbers? Explore our <a href="/packages">Wedding Catering Packages</a>,
        open our free <a href="/resources/budget-calculator">Wedding Budget Calculator</a>, or use our{' '}
        <a href="/resources/quote-builder">Quote Builder</a> to pick dishes and download a PDF summary.
      </p>
    </div>
  </article>

  <CtaBanner
    title="Want a Clear Written Quote"
    highlight="With Zero Hidden Fees?"
    primaryHref="/contact#quote-form"
    primaryLabel="Request a Free Quote"
  />
</BaseLayout>
