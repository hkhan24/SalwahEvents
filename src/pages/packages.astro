---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';
import InstantQuoteEstimator from '@/components/InstantQuoteEstimator';

import headerPackages from '@/assets/images/header-packages.png';
import { PACKAGES, PACKAGE_COMPARISON } from '@/data/packages';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildOfferCatalogSchema,
  buildServiceSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Wedding Packages' },
];

const faqs: FaqItem[] = [
  {
    question: 'What is included in the £25 per person Silver Package?',
    answer:
      'Our Silver Package (£25 per person) includes 3 starters, salad and chutneys, 4 main courses (chicken, lamb, vegetable, and daal), pilau rice with plain rice or naan, 1 dessert, full crockery and cutlery, and professional waiting staff.',
  },
  {
    question: 'What makes the £40 per person Gold Package your most popular choice?',
    answer:
      'The Gold Package (£40 per person) adds welcome drinks and canapés on arrival, 4 starters (chicken, lamb, fish, and vegetable), 4 premium main courses (chicken, lamb, prawn, and daal or vegetable), biryani or rice with breads, 2 desserts, full glassware, and an experienced floor supervisor.',
  },
  {
    question: 'What does the all-inclusive Platinum Package cover?',
    answer:
      'Starting from £17,500 for 200 guests (and scalable up to 1,000+ guests), our Platinum Package includes everything in the Gold Package plus full event management, luxury wedding stage decoration, venue lighting and setup, table centrepieces, a live dessert or paan stall, and a dedicated lead event manager.',
  },
  {
    question: 'Can we customise a package for smaller or larger guest counts?',
    answer:
      'Yes. We cater from 50 to 1,000+ guests across London, Essex, and Kent, and any package can be tailored with extra live stations, specific heritage dishes, or standalone wedding stage decoration.',
  },
];

const quickFacts = [
  { label: 'Halal Assurance', value: 'Exclusively HMC-certified Halal meat & poultry cooked in our London kitchen' },
  { label: 'Guest Scale', value: '50 to 1,000+ guests — intimate Nikah lunches to grand Walima receptions' },
  { label: 'Serviceware & Staff', value: 'Porcelain crockery, cutlery, chafing displays & uniformed waiting staff' },
  { label: 'Dietary Care', value: 'Dedicated vegetarian, vegan, nut-free & allergen-aware meal preparation' },
  { label: 'Food Sampling', value: 'Complimentary menu consultation & food sampling before you confirm' },
  { label: 'Areas Covered', value: 'Greater London (East, North, West & South), Essex & Kent' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildOfferCatalogSchema(),
  buildServiceSchema({
    name: 'Asian Wedding Catering Packages London',
    serviceType: 'Halal Wedding Catering Packages',
    description:
      'Transparent HMC-certified Halal Asian wedding catering packages in London, Essex & Kent: Silver (£25pp), Gold (£40pp), and Platinum all-inclusive catering + stage decor (from £17,500 for 200 guests).',
    url: '/packages',
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="Asian Wedding Catering Packages London | From £25pp | Salwah Events"
  description="Clear, honest Asian wedding catering packages in London, Essex & Kent: Silver (£25pp), Gold (£40pp with welcome drinks & canapés), and Platinum all-inclusive catering + stage decor from £17,500."
  canonicalPath="/packages"
  schemas={schemas}
>
  <PageHero
    eyebrow="Transparent Pricing · 50 to 1,000+ Guests"
    title="Honest Wedding"
    highlight="Packages"
    subtitle="Clear per-person Halal catering starting from £25pp with crockery and staff included — or hand over every detail with our all-inclusive Platinum catering, stage decor, and planning package."
    image={headerPackages}
    imageAlt="Luxury Asian wedding catering banquet setup in London"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="#quote-form"
    primaryCtaLabel="Request a Tailored Proposal"
  />

  <section class="py-12 sm:py-16 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-18">
      <!-- 1. 3 Signature Tier Cards FIRST (Zero redundancy above the fold) -->
      <div class="space-y-10">
        <div class="text-center max-w-2xl mx-auto">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-salwah-gold mb-2">
            Per-Head &amp; All-Inclusive Options
          </p>
          <div class="ornamental-divider mb-4" aria-hidden="true">
            <span class="ornamental-diamond" />
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">
            Choose Your <span class="gold-gradient-text italic font-semibold">Wedding Package</span>
          </h2>
          <p class="mt-3 text-sm sm:text-base text-gray-300">
            Every tier uses HMC-certified Halal meat and poultry and adapts freely to Bengali, Pakistani, or Indian menus.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch pt-4">
          {
            PACKAGES.map((pkg) => (
              <div
                id={pkg.id}
                class={`relative rounded-2xl p-8 flex flex-col ${
                  pkg.id === 'gold'
                    ? 'package-gold lg:-translate-y-2'
                    : pkg.id === 'platinum'
                      ? 'package-platinum'
                      : 'package-silver'
                }`}
              >
                {pkg.popular && (
                  <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-salwah-gold px-4 py-1 text-xs font-bold uppercase tracking-wider text-black shadow">
                    Most Popular Choice
                  </span>
                )}

                <div class="text-center pb-6 border-b border-white/10">
                  <h3 class="font-serif text-3xl font-bold text-white">{pkg.name}</h3>
                  <div class="mt-4">
                    <span class="block font-serif text-4xl sm:text-5xl font-bold text-salwah-gold leading-none">{pkg.price}</span>
                    <span class="mt-2 block text-xs uppercase tracking-[0.14em] text-gray-300">{pkg.unit}</span>
                  </div>
                  <p class="mt-4 text-sm text-gray-200/90 leading-relaxed">{pkg.tagline}</p>
                </div>

                <ul class="mt-6 space-y-3 text-sm text-gray-200 flex-1">
                  {pkg.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-salwah-gold font-bold mt-0.5 shrink-0" aria-hidden="true">&#10003;</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>

                <p class="mt-6 text-xs text-gray-300/80 italic text-center leading-relaxed">{pkg.summary}</p>

                <a
                  href="#quote-form"
                  class={`mt-6 inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold whitespace-nowrap ${
                    pkg.popular ? 'btn-luxury-gold' : 'btn-luxury-outline'
                  }`}
                >
                  {pkg.id === 'silver'
                    ? 'Choose Silver (£25pp)'
                    : pkg.id === 'gold'
                      ? 'Choose Gold (£40pp)'
                      : 'Enquire for Platinum'}
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 2. Interactive Instant Price Estimator -->
      <div class="block">
        <InstantQuoteEstimator client:visible />
      </div>

      <!-- 3. Side-by-Side Comparison Table (Mobile-friendly sticky left column + swipe cue) -->
      <div class="rounded-2xl border border-salwah-gold/25 bg-[#0e1017] p-5 sm:p-8">
        <div class="text-center mb-6 sm:mb-8">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">
            Side-by-Side <span class="gold-gradient-text italic font-semibold">Package Comparison</span>
          </h2>
          <p class="mt-2 text-sm text-gray-300">
            Compare every course, staff level, and decor inclusion in one glance.
          </p>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-salwah-gold md:hidden">
            &larr; Swipe table to compare all 3 tiers &rarr;
          </p>
        </div>

        <div class="overflow-x-auto -mx-2 px-2">
          <table class="w-full min-w-[580px] text-left border-collapse">
            <thead>
              <tr class="border-b border-salwah-gold/30 text-sm sm:text-base">
                <th class="sticky left-0 z-10 bg-[#0e1017] py-3.5 pr-4 pl-2 font-serif text-white">Inclusion</th>
                <th class="py-3.5 px-3 sm:px-4 font-serif text-white text-center">Silver</th>
                <th class="py-3.5 px-3 sm:px-4 font-serif text-salwah-gold text-center">Gold</th>
                <th class="py-3.5 px-3 sm:px-4 font-serif text-white text-center">Platinum</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-sm">
              {
                PACKAGE_COMPARISON.map((row) => (
                  <tr class="hover:bg-white/[0.02]">
                    <td class="sticky left-0 z-10 bg-[#0e1017] py-3.5 pr-4 pl-2 font-medium text-gray-200">{row.feature}</td>
                    <td class="py-3.5 px-3 sm:px-4 text-center text-gray-300">
                      {row.silver === true ? (
                        <span class="text-emerald-400 font-bold" aria-label="Included">&#10003;</span>
                      ) : row.silver === false ? (
                        <span class="text-gray-500" aria-label="Not included">&mdash;</span>
                      ) : (
                        row.silver
                      )}
                    </td>
                    <td class="py-3.5 px-3 sm:px-4 text-center font-semibold text-salwah-gold">
                      {row.gold === true ? (
                        <span class="text-emerald-400 font-bold" aria-label="Included">&#10003;</span>
                      ) : row.gold === false ? (
                        <span class="text-gray-500" aria-label="Not included">&mdash;</span>
                      ) : (
                        row.gold
                      )}
                    </td>
                    <td class="py-3.5 px-3 sm:px-4 text-center text-gray-300">
                      {row.platinum === true ? (
                        <span class="text-emerald-400 font-bold" aria-label="Included">&#10003;</span>
                      ) : row.platinum === false ? (
                        <span class="text-gray-500" aria-label="Not included">&mdash;</span>
                      ) : (
                        row.platinum
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="mt-6 text-center text-sm text-gray-300">
          Want to hand-pick your exact dishes and export a PDF summary? Try our free{' '}
          <a href="/resources/quote-builder" class="text-salwah-gold font-semibold underline hover:no-underline">Interactive Quote Builder</a>{' '}
          or{' '}
          <a href="/resources/budget-calculator" class="text-salwah-gold font-semibold underline hover:no-underline">Wedding Budget Calculator</a>.
        </div>
      </div>

      <!-- 4. Always Included Standards (Complements packages without duplicating them) -->
      <QuickFactsBox
        heading="Included With Every Booking"
        summary="Whichever tier fits your wedding, our core hospitality standards never change — fresh Halal preparation, attentive staff, and zero surprise surcharges."
        facts={quickFacts}
      />
    </div>
  </section>

  <!-- Inline Proposal Form -->
  <section id="quote-form" class="py-16 bg-salwah-surface border-t border-white/5">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteForm
        client:visible
        variant="compact"
        sourcePage="Packages Page"
        heading="Request Your Itemised Written Quote"
        subheading="Every event is tailored. Share your date, guest count, and preferred tier for clear written pricing."
      />
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <CtaBanner
    title="Want to See Every Dish"
    highlight="Included in These Packages?"
    subtitle="Explore 52 authentic Bengali, Pakistani, and Indian dishes cooked fresh with HMC-certified Halal meat and poultry — ready to mix and match for your celebration."
    primaryHref="/menu"
    primaryLabel="Explore Full Halal Menu"
  />
</BaseLayout>
