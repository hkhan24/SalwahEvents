---
import ToolPageLayout from '@/layouts/ToolPageLayout.astro';
import SeatingVisualiserTool from '@/components/tools/SeatingVisualiserTool';
---

<ToolPageLayout
  title="Seating Style Visualiser"
  metaTitle="Wedding Reception Table Layout Visualiser | Salwah Events"
  description="Compare round vs. long banquet table arrangements for 50 to 1,000+ wedding guests instantly."
  canonicalPath="/resources/seating-visualiser"
  heroTitle="Seating Style"
  heroHighlight="Visualiser"
  subtitle="Compare round (10-seat) vs. long (20-seat) banquet layouts for your venue hall."
  maxWidth="7xl"
  howToUse={[
    'Enter your estimated guest count.',
    'Switch between Round Tables and Long Banquet Tables.',
    'See how many tables your reception ballroom will require.',
  ]}
>
  <SeatingVisualiserTool client:load />
</ToolPageLayout>
