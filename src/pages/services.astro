---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';

import headerServices from '@/assets/images/header-services.png';
import cardCatering from '@/assets/images/service-catering-card.jpg';
import cardStage from '@/assets/images/service-stage-card.jpg';
import cardPlanning from '@/assets/images/service-planning-card.jpg';
import cardVenues from '@/assets/images/service-venues-card.jpg';

import { buildBreadcrumbSchema, type BreadcrumbItem } from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Services' },
];

const services = [
  {
    title: 'Asian Wedding Catering',
    href: '/services/asian-wedding-catering',
    badge: 'From £25pp',
    ctaLabel: 'Explore Wedding Catering',
    description:
      'Authentic Bengali, Pakistani, and Indian cuisine prepared with HMC-certified Halal meat and poultry — with uniformed waiting staff, crockery, and cutlery included.',
    image: cardCatering,
    alt: 'Halal Asian wedding catering service in London',
  },
  {
    title: 'Wedding Stage Decoration',
    href: '/services/wedding-stage-decoration',
    badge: 'Bespoke Design',
    ctaLabel: 'See Stage Designs',
    description:
      'Bespoke floral walls, Nikah partitions, colourful Mehndi stages, Walima backdrops, Mandaps, mood lighting, and full ballroom table centrepieces.',
    image: cardStage,
    alt: 'Bespoke Asian wedding stage decoration in London',
  },
  {
    title: 'Event Management & Planning',
    href: '/services/event-management-planning',
    badge: 'End-to-End',
    ctaLabel: 'See How We Plan',
    description:
      'Complete timelines, supplier coordination, budget planning, and dedicated on-the-day management so you and your family enjoy every moment.',
    image: cardPlanning,
    alt: 'Full Asian wedding event management and planning London',
  },
  {
    title: 'Partner Venues & Locations',
    href: '/services/venues-locations',
    badge: 'London, Essex & Kent',
    ctaLabel: 'View Partner Venues',
    description:
      'Discover our trusted banqueting hall and dry-hire estate partners including The City Pavilion, Meridian Grand, The Willows, and Mayfair Venue.',
    image: cardVenues,
    alt: 'Luxury Asian wedding venues across London, Essex and Kent',
  },
];

const regionalLinks = [
  { label: 'Bengali Wedding Catering', href: '/bengali-wedding-catering-london' },
  { label: 'Pakistani Wedding Catering', href: '/pakistani-wedding-catering-london' },
  { label: 'Indian Wedding Catering', href: '/indian-wedding-catering-london' },
  { label: 'Nikah & Walima Catering', href: '/nikah-walima-catering-london' },
  { label: 'Mehndi & Gaye Holud', href: '/mehndi-gaye-holud-catering-london' },
  { label: 'Dry-Hire & Hotel Catering', href: '/dry-hire-asian-wedding-catering-london' },
  { label: 'East London Catering', href: '/halal-wedding-catering-east-london' },
  { label: 'North & West London', href: '/halal-wedding-catering-north-west-london' },
  { label: 'Essex & Kent Catering', href: '/halal-wedding-catering-essex-kent' },
];
---

<BaseLayout
  title="Asian Wedding Services London | Halal Catering, Stage Decor & Planning | Salwah Events"
  description="Complete Asian wedding services in London, Essex & Kent: authentic HMC-certified Halal catering from £25pp, bespoke stage decoration, full event management, and partner venues."
  canonicalPath="/services"
  schemas={[buildBreadcrumbSchema(breadcrumbs)]}
>
  <PageHero
    eyebrow="One Coordinated Team · London, Essex & Kent"
    title="Catering, Stage Decor &"
    highlight="Event Planning"
    subtitle="Book our HMC-certified Halal kitchen, bespoke floral stage studio, or full wedding planning team individually — or bring everything together under one calm run-sheet."
    image={headerServices}
    imageAlt="Salwah Events Asian wedding catering and decor services in London"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="/contact#quote-form"
    primaryCtaLabel="Request a Tailored Quote"
  />

  <section class="py-16 sm:py-20 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          services.map((service) => (
            <a href={service.href} class="group luxury-card rounded-2xl overflow-hidden flex flex-col">
              <div class="aspect-[16/9] overflow-hidden bg-black">
                <Picture
                  src={service.image}
                  alt={service.alt}
                  widths={[480, 800]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  formats={['webp']} fallbackFormat="webp" quality={78}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-7 flex flex-col flex-1">
                <span class="text-xs font-bold uppercase tracking-widest text-salwah-gold">
                  {service.badge}
                </span>
                <h2 class="mt-1.5 font-serif text-2xl sm:text-3xl font-bold text-white group-hover:text-salwah-gold transition">
                  {service.title}
                </h2>
                <p class="mt-3 text-sm sm:text-base text-gray-300 leading-relaxed flex-1">
                  {service.description}
                </p>
                <span class="mt-5 inline-flex items-center text-sm font-bold text-salwah-gold">
                  {service.ctaLabel} &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Specialist Cuisine & Regional Pages -->
      <div class="rounded-2xl border border-salwah-gold/25 bg-[#0e1017] p-7 sm:p-10 text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">
          Looking for a Specialist <span class="text-salwah-gold">Cuisine or Region?</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-300 max-w-2xl mx-auto mb-6">
          Explore our dedicated catering guides with sample menus, guest capacities, and transparent pricing:
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {
            regionalLinks.map((item) => (
              <a
                href={item.href}
                class="rounded-xl border border-salwah-gold/40 bg-black/60 px-5 py-3 text-sm font-semibold text-salwah-gold hover:bg-salwah-gold hover:text-black transition"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
