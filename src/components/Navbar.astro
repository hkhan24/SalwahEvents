---
import { Image } from 'astro:assets';
import salwahLogo from '@/assets/images/salwah-logo.png';
import { NAV_LINKS, SITE } from '@/data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalized = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
---

<header class="sticky top-0 z-50 border-b border-salwah-gold/20 bg-salwah-black/95 backdrop-blur-md">
  <!-- Top Trust Strip (Desktop) -->
  <div class="hidden lg:block border-b border-white/10 bg-[#0a0b0f] text-xs text-gray-300">
    <div class="max-w-7xl mx-auto px-6 py-2 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5 tracking-wide">
        <span class="text-salwah-gold font-semibold">HMC-Certified Halal</span>
        <span class="text-white/30" aria-hidden="true">&middot;</span>
        <span>Packages From £25pp</span>
        <span class="text-white/30" aria-hidden="true">&middot;</span>
        <span>50–1,000+ Guests</span>
        <span class="text-white/30" aria-hidden="true">&middot;</span>
        <span>Greater London, Essex &amp; Kent</span>
      </div>
      <div class="flex items-center gap-4">
        <a href={SITE.phoneHref} class="text-gray-200 hover:text-salwah-gold font-medium transition">
          {SITE.phoneDisplay}
        </a>
        <span class="text-white/25" aria-hidden="true">|</span>
        <a
          href={SITE.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-gray-200 hover:text-salwah-gold font-medium transition"
        >
          <svg class="h-3.5 w-3.5 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Primary Navigation">
    <div class="flex items-center justify-between h-20 gap-4">
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Salwah Events and Catering Home">
        <Image
          src={salwahLogo}
          alt="Salwah Events and Catering gold calligraphy logo"
          widths={[540, 1080, 1499]}
          sizes="(max-width: 640px) 198px, 234px"
          width={234}
          height={52}
          format="png"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="h-11 sm:h-12 w-auto select-none drop-shadow-[0_1px_10px_rgba(246,223,145,0.18)]"
        />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex items-center gap-1 xl:gap-2">
        {
          NAV_LINKS.map((item) => {
            const isActive =
              item.href === '/'
                ? normalized === '/'
                : normalized === item.href || normalized.startsWith(`${item.href}/`);

            if (item.children) {
              return (
                <div class="relative group">
                  <a
                    href={item.href}
                    class={`inline-flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition ${
                      isActive ? 'text-salwah-gold' : 'text-gray-200 hover:text-salwah-gold'
                    }`}
                  >
                    {item.label}
                    <svg class="w-3.5 h-3.5 opacity-75" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>
                  <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-2 w-64 z-50">
                    <div class="rounded-xl border border-salwah-gold/25 bg-[#0e1017] p-2 shadow-2xl">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          class={`block rounded-lg px-3.5 py-2.5 text-sm transition ${
                            normalized === child.href
                              ? 'bg-salwah-gold/15 text-salwah-gold font-semibold'
                              : 'text-gray-200 hover:bg-white/5 hover:text-salwah-gold'
                          }`}
                        >
                          {child.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition ${
                  isActive ? 'text-salwah-gold' : 'text-gray-200 hover:text-salwah-gold'
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3 shrink-0">
        <a
          href="/contact#quote-form"
          class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-bold whitespace-nowrap"
        >
          Check Availability
        </a>
      </div>

      <!-- Mobile Quick Controls -->
      <div class="flex lg:hidden items-center gap-2.5">
        <a
          href={SITE.phoneHref}
          aria-label={`Call Salwah Events on ${SITE.phoneDisplay}`}
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-salwah-gold/40 bg-salwah-gold/10 text-salwah-gold"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </a>
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label="Open navigation menu"
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-salwah-gold text-black"
        >
          <svg id="nav-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg id="nav-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-nav-panel"
    class="hidden lg:hidden border-t border-salwah-gold/20 bg-[#0a0b10] max-h-[80vh] overflow-y-auto"
  >
    <div class="px-5 py-5 space-y-1">
      {
        NAV_LINKS.map((item) => (
          <div>
            <a
              href={item.href}
              class={`block rounded-lg px-3 py-2.5 text-base font-semibold ${
                normalized === item.href ? 'text-salwah-gold bg-salwah-gold/10' : 'text-white hover:text-salwah-gold'
              }`}
            >
              {item.label}
            </a>
            {item.children && (
              <div class="pl-4 pb-2 space-y-1 border-l border-salwah-gold/20 ml-3">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`block rounded-md px-3 py-2 text-sm ${
                      normalized === child.href ? 'text-salwah-gold font-semibold' : 'text-gray-300 hover:text-salwah-gold'
                    }`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
      <div class="pt-4 mt-4 border-t border-white/10 grid grid-cols-2 gap-3">
        <a
          href={SITE.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-luxury-whatsapp inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold"
        >
          <svg class="h-4 w-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
          </svg>
          WhatsApp
        </a>
        <a
          href="/contact#quote-form"
          class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-bold"
        >
          Check Availability
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-nav-toggle');
    var panel = document.getElementById('mobile-nav-panel');
    var openIcon = document.getElementById('nav-icon-open');
    var closeIcon = document.getElementById('nav-icon-close');
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      panel.classList.toggle('hidden');
      if (openIcon) openIcon.classList.toggle('hidden');
      if (closeIcon) closeIcon.classList.toggle('hidden');
    });
  })();
</script>
