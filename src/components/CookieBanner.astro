---
---

<div
  id="salwah-cookie-banner"
  class="hidden fixed bottom-20 md:bottom-4 left-3 right-3 md:left-4 md:right-auto md:max-w-sm z-40 rounded-2xl border border-salwah-gold/30 bg-[#0d0f16]/95 p-4 shadow-2xl backdrop-blur-md"
  role="dialog"
  aria-label="Cookie Notice"
>
  <p class="text-xs text-gray-300 leading-relaxed">
    We use cookies to measure site performance and improve your experience. See our{' '}
    <a href="/cookie-notice" class="text-salwah-gold underline hover:no-underline">Cookie Notice</a>.
  </p>
  <div class="mt-3 flex items-center gap-2">
    <button
      id="cookie-accept-btn"
      type="button"
      class="btn-luxury-gold flex-1 rounded-lg px-3 py-2 text-xs font-bold cursor-pointer"
    >
      Accept
    </button>
    <button
      id="cookie-decline-btn"
      type="button"
      class="flex-1 rounded-lg border border-salwah-gold/35 bg-black/50 px-3 py-2 text-xs font-semibold text-gray-200 hover:border-salwah-gold hover:text-salwah-gold transition cursor-pointer"
    >
      Decline
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById('salwah-cookie-banner');
    if (!banner) return;
    try {
      if (!localStorage.getItem('salwah_cookie_consent')) {
        banner.classList.remove('hidden');
      }
      var dismiss = function (val) {
        localStorage.setItem('salwah_cookie_consent', val);
        banner.classList.add('hidden');
      };
      var acc = document.getElementById('cookie-accept-btn');
      var dec = document.getElementById('cookie-decline-btn');
      if (acc) acc.addEventListener('click', function () { dismiss('accepted'); });
      if (dec) dec.addEventListener('click', function () { dismiss('declined'); });
    } catch (e) {}
  })();
</script>
