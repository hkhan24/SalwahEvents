---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';

import heroImg from '@/assets/images/blog-nikah-checklist.png';
import { buildBlogPostingSchema, buildBreadcrumbSchema, type BreadcrumbItem } from '@/lib/schema';

const url = '/blog/how-to-plan-a-pakistani-nikah-ceremony-a-checklist';
const title = 'How to Plan a Pakistani Nikah Ceremony – A Complete Checklist';
const description =
  'Step-by-step Pakistani Nikah ceremony checklist for London couples: UK legal notice, Imam booking, Mehr, HMC Halal catering, Nikah decor, and on-the-day order of events.';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: 'Pakistani Nikah Checklist' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildBlogPostingSchema({ title, description, url, publishedIso: '2025-08-29' }),
];
---

<BaseLayout
  title={`${title} | Salwah Events`}
  description={description}
  canonicalPath={url}
  ogType="article"
  schemas={schemas}
>
  <PageHero
    eyebrow="Published August 29, 2025 • 6 Min Read"
    title="How to Plan a Pakistani"
    highlight="Nikah Ceremony"
    subtitle="A complete, practical checklist covering UK legal notice, Mehr, HMC Halal catering, floral Nikah backdrops, and ceremony order of events."
    image={heroImg}
    imageAlt="Pakistani Nikah ceremony couple signing marriage contract in London"
    breadcrumbs={breadcrumbs}
    showTrustBadges={false}
    showCtas={false}
  />

  <article class="py-14 sm:py-20 bg-salwah-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-invert prose-lg prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold text-gray-300">
      <p class="lead text-gray-200">
        The Nikah is the spiritual cornerstone of a Muslim wedding. Planning a Pakistani Nikah in
        London blends religious tradition, UK civil requirements, and heartfelt family hospitality.
        Use this checklist from our{' '}
        <a href="/pakistani-wedding-catering-london">Pakistani wedding catering &amp; planning team</a>{' '}
        to keep every milestone calm and organised.
      </p>

      <h2>Phase 1: Foundations (3–6 Months Before)</h2>
      <ul>
        <li><strong>Confirm Your Date &amp; Mosque/Venue:</strong> Align with both families and reserve your mosque, community hall, home marquee, or <a href="/services/venues-locations">London wedding venue</a>.</li>
        <li><strong>Book Your Imam / Officiant:</strong> Confirm whether the venue is registered for a civil marriage or whether you will complete a separate registry office ceremony.</li>
        <li><strong>Give UK Legal Notice:</strong> Give notice at your local register office at least 29 days prior to a civil marriage.</li>
        <li><strong>Estimate Guest Numbers:</strong> Decide whether the Nikah is an intimate 50–120 guest ceremony or combined with a full reception (try our free <a href="/resources/guest-estimator">Guest Cost Estimator</a>).</li>
      </ul>

      <div class="not-prose my-8 rounded-2xl overflow-hidden border border-salwah-gold/20">
        <Picture src={heroImg} alt="Couple celebrating a traditional Pakistani Nikah ceremony in London" widths={[480, 800]} formats={['webp']} fallbackFormat="webp" quality={78} loading="lazy" class="w-full h-72 object-cover" />
      </div>

      <h2>Phase 2: Vendors &amp; Details (1–3 Months Before)</h2>
      <ul>
        <li><strong>Agree on the Mehr:</strong> Both families confirm the Mehr amount and terms for the Nikah-nama contract.</li>
        <li><strong>Book 100% HMC Halal Catering:</strong> Whether light refreshments, kebabs &amp; Kashmiri pink chai or a full lamb karahi &amp; biryani banquet, lock in your <a href="/services/asian-wedding-catering">Halal caterer</a> early.</li>
        <li><strong>Design Your Nikah Backdrop &amp; Partition:</strong> Reserve a serene floral backdrop and modest partition through our <a href="/services/wedding-stage-decoration">wedding stage decoration</a> team.</li>
        <li><strong>Book Photographer &amp; Send Invites:</strong> Use our free <a href="/resources/invitation-generator">Nikah Invitation Wording Generator</a> to draft formal or traditional invite text in seconds.</li>
      </ul>

      <h2>Phase 3: The Week Of the Nikah</h2>
      <ul>
        <li>Confirm timings with your Imam, venue manager, caterer, and decorator.</li>
        <li>Prepare ID documents for the bride, groom, Wali, and two witnesses.</li>
        <li>Arrange the decorative Nikah pen, ring platter, dates, and sweet favours (mithai) for guests.</li>
      </ul>

      <h2>Typical Order of Events on the Day</h2>
      <ol>
        <li>Arrival of both families with chilled welcome mocktails or karak chai.</li>
        <li>Recitation of the Qur'an and Khutbah by the Imam.</li>
        <li>Formal declaration of consent (Ijab and Qubul) and signing of the Nikah-nama.</li>
        <li>Collective Dua, Mubarak greetings, dates &amp; mithai distribution.</li>
        <li>Couple &amp; family portraits followed by a joyful Halal Nikah feast.</li>
      </ol>

      <p>
        Need a printable schedule? Download our free{' '}
        <a href="/resources/timeline-templates">Nikah &amp; Walima Timeline PDF Templates</a>.
      </p>
    </div>
  </article>

  <CtaBanner title="Planning Your Nikah" highlight="in London, Essex or Kent?" primaryHref="/contact#quote-form" primaryLabel="Get Nikah Catering & Decor Quote" />
</BaseLayout>
