---
import { Image } from 'astro:assets';
import salwahLogo from '@/assets/images/salwah-logo.png';
import { SITE } from '@/data/site';

const currentYear = new Date().getFullYear();

const cateringLinks = [
  { label: 'Asian Wedding Catering London', href: '/services/asian-wedding-catering' },
  { label: 'Bengali Wedding Catering', href: '/bengali-wedding-catering-london' },
  { label: 'Pakistani Wedding Catering', href: '/pakistani-wedding-catering-london' },
  { label: 'Indian Wedding Catering', href: '/indian-wedding-catering-london' },
  { label: 'Nikah & Walima Catering', href: '/nikah-walima-catering-london' },
  { label: 'Mehndi & Gaye Holud Catering', href: '/mehndi-gaye-holud-catering-london' },
  { label: 'Dry-Hire, Hotel & Marquee Catering', href: '/dry-hire-asian-wedding-catering-london' },
  { label: 'East London Halal Catering', href: '/halal-wedding-catering-east-london' },
  { label: 'North & West London Catering', href: '/halal-wedding-catering-north-west-london' },
  { label: 'Essex & Kent Halal Catering', href: '/halal-wedding-catering-essex-kent' },
];

const areaAndServiceLinks = [
  { label: 'Wedding Stage Decoration', href: '/services/wedding-stage-decoration' },
  { label: 'Event Management & Planning', href: '/services/event-management-planning' },
  { label: 'Partner Venues & Locations', href: '/services/venues-locations' },
  { label: 'Full Halal Wedding Menu', href: '/menu' },
  { label: 'Wedding Packages (From £25pp)', href: '/packages' },
  { label: 'Gallery & Portfolio', href: '/gallery' },
  { label: '14 Free Planning Tools', href: '/resources' },
  { label: 'Wedding Planning Blog', href: '/blog' },
  { label: 'About Salwah Events', href: '/about' },
  { label: 'Contact & Enquiries', href: '/contact' },
];
---

<footer class="border-t border-salwah-gold/25 bg-[#040406] text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand & NAP -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label={SITE.businessName}>
          <Image
            src={salwahLogo}
            alt="Salwah Events and Catering Logo"
            widths={[540, 1080, 1499]}
            sizes="252px"
            width={252}
            height={56}
            format="png"
            loading="lazy"
            class="h-13 w-auto select-none drop-shadow-[0_1px_10px_rgba(246,223,145,0.16)]"
          />
        </a>
        <p class="text-sm text-gray-200/90 leading-relaxed">
          Family-led HMC-certified Halal Asian wedding catering, bespoke stage decoration, and full
          event management across Greater London, Essex, and Kent.
        </p>
        <div class="text-xs text-gray-300/80 space-y-1">
          <p>{SITE.legalName}</p>
          <p>Companies House No: {SITE.companiesHouseNo}</p>
          <p>VAT Registration No: {SITE.vatNo}</p>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <a
            href={SITE.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salwah Events on Facebook"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-salwah-gold/30 bg-salwah-gold/10 text-salwah-gold hover:bg-salwah-gold hover:text-black transition"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
          </a>
          <a
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salwah Events on Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-salwah-gold/30 bg-salwah-gold/10 text-salwah-gold hover:bg-salwah-gold hover:text-black transition"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
          <a
            href={SITE.social.trustpilot}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salwah Events on Trustpilot"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-salwah-gold/30 bg-salwah-gold/10 text-salwah-gold hover:bg-salwah-gold hover:text-black transition"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Catering & Areas -->
      <div>
        <h3 class="font-serif text-lg font-semibold text-salwah-gold mb-4">Catering &amp; Areas</h3>
        <ul class="space-y-2.5 text-sm">
          {
            cateringLinks.map((link) => (
              <li>
                <a href={link.href} class="text-gray-200/90 hover:text-salwah-gold transition">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Decor, Planning & Company -->
      <div>
        <h3 class="font-serif text-lg font-semibold text-salwah-gold mb-4">Decor, Menus &amp; Planning</h3>
        <ul class="space-y-2.5 text-sm">
          {
            areaAndServiceLinks.map((link) => (
              <li>
                <a href={link.href} class="text-gray-200/90 hover:text-salwah-gold transition">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Verified GBP Contact -->
      <div>
        <h3 class="font-serif text-lg font-semibold text-salwah-gold mb-4">Get in Touch</h3>
        <address class="not-italic space-y-3.5 text-sm">
          <p class="font-semibold text-white">{SITE.businessName}</p>
          <a
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block text-gray-200/90 hover:text-salwah-gold transition leading-relaxed"
          >
            {SITE.address.full}
          </a>
          <p>
            <span class="text-gray-300/80">Phone / WhatsApp:</span>{' '}
            <a href={SITE.phoneHref} class="text-white font-semibold hover:text-salwah-gold transition">
              {SITE.phoneDisplay}
            </a>
          </p>
          <p>
            <span class="text-gray-300/80">Email:</span>{' '}
            <a href={SITE.emailHref} class="text-white hover:text-salwah-gold transition">
              {SITE.email}
            </a>
          </p>
          <p class="text-xs text-salwah-gold/90 font-medium">{SITE.openingHours.display}</p>
          <div class="pt-2 flex flex-col gap-2.5">
            <a
              href="/contact#quote-form"
              class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-bold"
            >
              Book a Free Consultation
            </a>
            <a
              href={SITE.whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-luxury-whatsapp inline-flex items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold"
            >
              <svg class="h-4 w-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
              </svg>
              Message on WhatsApp
            </a>
          </div>
        </address>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-salwah-gold/15 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-300/75">
      <p>&copy; {currentYear} {SITE.businessName} ({SITE.legalName}). All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy-policy" class="hover:text-salwah-gold transition">Privacy Policy</a>
        <a href="/cookie-notice" class="hover:text-salwah-gold transition">Cookie Notice</a>
        <a href="/sitemap.xml" class="hover:text-salwah-gold transition">Sitemap</a>
        <a href="/llms.txt" class="hover:text-salwah-gold transition">AI Info</a>
      </div>
    </div>
  </div>
</footer>
