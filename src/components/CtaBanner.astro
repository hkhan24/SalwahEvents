---
import { SITE } from '@/data/site';

interface Props {
  title?: string;
  highlight?: string;
  subtitle?: string;
  primaryHref?: string;
  primaryLabel?: string;
}

const {
  title = 'Let’s Plan',
  highlight = 'Your Celebration',
  subtitle = 'Share your date, guest count, and vision. Whether you need HMC-certified Halal catering, bespoke stage decor, or full event management, we reply promptly with clear written pricing — and zero pressure.',
  primaryHref = '/contact#quote-form',
  primaryLabel = 'Book a Free Consultation',
} = Astro.props;
---

<section class="relative overflow-hidden py-18 sm:py-24 bg-gradient-to-br from-[#231b09] via-[#0c0d13] to-salwah-black border-t border-salwah-gold/30">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(246,223,145,0.14),transparent_70%)]" aria-hidden="true" />
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-salwah-gold mb-3">
      Greater London &middot; Essex &middot; Kent &middot; Peak Weekends Fill Early
    </p>
    <div class="ornamental-divider mb-5" aria-hidden="true">
      <span class="ornamental-diamond" />
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
      {title} <span class="gold-gradient-text italic font-semibold">{highlight}</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-gray-200 max-w-2xl mx-auto leading-relaxed">
      {subtitle}
    </p>
    <div class="mt-9 flex flex-col sm:flex-row justify-center gap-3.5">
      <a
        href={primaryHref}
        class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-7 py-3.5 text-sm sm:text-base font-bold whitespace-nowrap"
      >
        {primaryLabel}
      </a>
      <a
        href={SITE.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-luxury-whatsapp inline-flex items-center justify-center gap-2 rounded-xl px-7 py-3.5 text-sm sm:text-base font-semibold whitespace-nowrap"
      >
        <svg class="h-4 w-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
        </svg>
        <span>WhatsApp {SITE.phoneDisplay}</span>
      </a>
      <a
        href={SITE.phoneHref}
        class="btn-luxury-outline inline-flex items-center justify-center rounded-xl px-7 py-3.5 text-sm sm:text-base font-semibold whitespace-nowrap"
      >
        Call {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>
