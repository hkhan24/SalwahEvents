---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqSection from '@/components/FaqSection.astro';
import QuoteForm from '@/components/QuoteForm';

import headerContact from '@/assets/images/header-contact.png';
import { SITE } from '@/data/site';
import { buildBreadcrumbSchema, buildFaqSchema, type BreadcrumbItem, type FaqItem } from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Contact Us' },
];

const faqs: FaqItem[] = [
  {
    question: 'How quickly will Salwah Events respond to my quote enquiry?',
    answer:
      'We respond to website enquiries within a few hours during business hours (Mon–Sun, 9am–7pm). For immediate answers on date availability, call or WhatsApp 07359 337887.',
  },
  {
    question: 'Where is Salwah Events and Catering located?',
    answer:
      'Our London headquarters and production kitchen are at Number 19, Unit 7 Landmark Commercial Centre, Commercial Road, Edmonton, London, N18 1UB — serving Greater London, Essex, and Kent.',
  },
  {
    question: 'Can we book a menu consultation and food sampling before securing our date?',
    answer:
      'Yes! Submit your event date, estimated guest count, and cuisine preferences using the form above and our team will schedule a tailored menu consultation and food sampling.',
  },
];
---

<BaseLayout
  title="Contact Salwah Events | Free Halal Wedding Catering Quote London"
  description="Contact Salwah Events and Catering for 100% HMC Halal Asian wedding catering, stage decor & event management in London, Essex & Kent. Call or WhatsApp 07359 337887."
  canonicalPath="/contact"
  schemas={[buildBreadcrumbSchema(breadcrumbs), buildFaqSchema(faqs)]}
>
  <PageHero
    eyebrow="Fast Response • 7 Days a Week"
    title="Contact"
    highlight="Salwah Events"
    subtitle="Get a tailored quote for 100% HMC Certified Halal Asian wedding catering, bespoke stage decor, or full event management across Greater London, Essex, and Kent."
    image={headerContact}
    imageAlt="Contact Salwah Events and Catering in Edmonton London"
    breadcrumbs={breadcrumbs}
    showCtas={false}
  />

  <section class="py-14 sm:py-20 bg-salwah-black" id="quote-form">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7">
          <QuoteForm
            client:load
            variant="full"
            sourcePage="Contact Page"
            heading="Send Your Event Enquiry"
            subheading="Tell us your event date, guest count (50–1,000+), and preferred services — we reply promptly."
            hideWhatsAppFooter={true}
          />
        </div>

        <div class="lg:col-span-5 space-y-6">
          <!-- Direct Contact Cards (Unified Obsidian & Warm Gold Icons) -->
          <div class="luxury-card rounded-2xl p-6 sm:p-8 space-y-5">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white">
              Direct <span class="text-salwah-gold">Contact Details</span>
            </h2>

            <div class="space-y-3.5">
              <a
                href={SITE.phoneHref}
                class="flex items-center gap-4 rounded-xl border border-salwah-gold/25 bg-black/55 p-4 hover:border-salwah-gold transition group"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-salwah-gold/30 bg-salwah-gold/12 text-salwah-gold group-hover:bg-salwah-gold group-hover:text-black transition">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs uppercase tracking-wider text-gray-300/80">Call Direct</p>
                  <p class="text-lg font-bold text-white group-hover:text-salwah-gold transition">{SITE.phoneDisplay}</p>
                </div>
              </a>

              <a
                href={SITE.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 rounded-xl border border-salwah-gold/35 bg-black/55 p-4 hover:border-salwah-gold transition group"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-salwah-gold/30 bg-salwah-gold/12 text-[#25D366] group-hover:border-salwah-gold transition">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs uppercase tracking-wider text-salwah-gold">WhatsApp &middot; Fastest Reply</p>
                  <p class="text-lg font-bold text-white group-hover:text-salwah-gold transition">Message Us on WhatsApp</p>
                </div>
              </a>

              <a
                href={SITE.emailHref}
                class="flex items-center gap-4 rounded-xl border border-salwah-gold/25 bg-black/55 p-4 hover:border-salwah-gold transition group"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-salwah-gold/30 bg-salwah-gold/12 text-salwah-gold group-hover:bg-salwah-gold group-hover:text-black transition">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs uppercase tracking-wider text-gray-300/80">Email</p>
                  <p class="text-base font-semibold text-white group-hover:text-salwah-gold transition">{SITE.email}</p>
                </div>
              </a>
            </div>

            <div class="pt-4 border-t border-white/10 text-sm text-gray-200/90 space-y-1.5">
              <p class="font-semibold text-white">{SITE.businessName} ({SITE.legalName})</p>
              <p>{SITE.address.full}</p>
              <p class="text-xs text-salwah-gold font-medium">{SITE.openingHours.display}</p>
            </div>
          </div>

          <!-- Quote Builder Link Card -->
          <div class="luxury-card rounded-2xl p-6 space-y-3">
            <h3 class="font-serif text-xl font-bold text-salwah-gold">Build a Custom Dish List First?</h3>
            <p class="text-sm text-gray-300 leading-relaxed">
              Pick your Silver, Gold, or Platinum package and exact menu dishes with our free{' '}
              <a href="/resources/quote-builder" class="text-salwah-gold font-semibold underline hover:no-underline">Quote Builder tool</a>,
              then email your generated PDF to {SITE.email}.
            </p>
          </div>

          <!-- Location Header + Google Map -->
          <div class="rounded-2xl overflow-hidden border border-salwah-gold/25 bg-[#101219]">
            <div class="flex items-center justify-between gap-3 px-5 py-3.5 border-b border-white/10 bg-black/50">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-salwah-gold">Our London Kitchen</p>
                <p class="text-xs text-gray-300">Edmonton, North London (N18 1UB)</p>
              </div>
              <a
                href={SITE.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-salwah-gold hover:underline whitespace-nowrap"
              >
                Open Maps &rarr;
              </a>
            </div>
            <div class="h-64 bg-[#0b0d13]">
              <iframe
                src={SITE.mapsEmbedUrl}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Salwah Events and Catering — Edmonton, London N18 1UB"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} />
</BaseLayout>
