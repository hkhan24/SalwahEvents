---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';

import headerCatering from '@/assets/images/header-asian-catering.png';
import cateringBuffet from '@/assets/images/catering-buffet.jpg';
import menuBiryani from '@/assets/images/menu-biryani.png';
import menuMains from '@/assets/images/menu-mains.png';
import menuStarters from '@/assets/images/menu-starters.png';

import { PACKAGES } from '@/data/packages';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Asian Wedding Catering' },
];

const faqs: FaqItem[] = [
  {
    question: 'Is all of Salwah Events Asian wedding catering 100% HMC Certified Halal?',
    answer:
      'Yes, 100%. We are a dedicated Halal caterer sourcing all meat and poultry exclusively from HMC-certified suppliers, prepared in our Edmonton, London Halal production kitchens.',
  },
  {
    question: 'How much does Asian wedding catering cost per head in London?',
    answer:
      'Our Halal Asian wedding catering packages start from £25 per person for the Silver Package (3 starters, 4 mains, pilau rice, plain rice or naan, 1 dessert, crockery, cutlery, and waiting staff) and £40 per person for our most popular Gold Package (adding welcome drinks, canapés, 4 starters including fish, 4 premium mains, 2 desserts, glassware, and a floor supervisor). All-inclusive Platinum catering and stage decoration starts from £17,500 for 200 guests.',
  },
  {
    question: 'What guest numbers can you cater for?',
    answer:
      'We cater smoothly for intimate Nikah and Mehndi celebrations starting from 50 guests right up to grand multi-hall receptions and Walimas for 1,000+ guests across Greater London, Essex, and Kent.',
  },
  {
    question: 'Can you cater for vegetarian, vegan, nut-free, and gluten-free guests?',
    answer:
      'Absolutely. We prepare dedicated vegetarian and vegan South Asian dishes (such as paneer butter makhni, saag aloo, tarka daal, and vegetable samosas) alongside allergen-safe plated meals for guests with specific allergies.',
  },
  {
    question: 'Can we sample your wedding menus before confirming our booking?',
    answer:
      'Yes. We offer a complimentary menu consultation and food sampling sessions so you and your family can experience our spice profiles, portion quality, and presentation before finalising your wedding menu.',
  },
  {
    question: 'What welcome drinks and hot beverage stations do you provide?',
    answer:
      'We provide handcrafted fruit welcome mocktails, traditional Bengali spiced borhani, mango lassi, freshly brewed cardamom karak chai, Kashmiri pink chai, and artisan coffee tailored to your guest count.',
  },
];

const quickFacts = [
  { label: 'Starting Price', value: 'From £25 per person (Silver) • £40pp (Gold) • From £17,500 (Platinum, 200 guests)' },
  { label: 'Guest Capacity', value: '50 to 1,000+ guests (Single or Multi-Day Weddings & Celebrations)' },
  { label: 'Halal Standard', value: '100% HMC Certified Halal Meat & Poultry • Dedicated Halal Kitchen' },
  { label: 'Signature Cuisines', value: 'Bengali (Bangladeshi), Pakistani & Indian Wedding Menus' },
  { label: 'Service Styles', value: 'Grand Buffet, Family-Style Table Service, Plated Dining & Live Stalls' },
  { label: 'Coverage Areas', value: 'Greater London, East London, North London, West London, Essex & Kent' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildServiceSchema({
    name: 'Asian Wedding Catering London, Essex & Kent',
    serviceType: 'Halal Asian Wedding Catering',
    description:
      'Authentic Bengali, Pakistani, and Indian wedding catering using exclusively HMC-certified Halal meat and poultry across London, Essex, and Kent. Packages from £25 per person for 50–1,000+ guests.',
    url: '/services/asian-wedding-catering',
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="Asian Wedding Catering London | Halal Menus From £25pp | Salwah Events"
  description="Authentic Bengali, Pakistani & Indian wedding catering in London, Essex & Kent using exclusively HMC-certified Halal meat & poultry. Transparent packages from £25pp for 50–1,000+ guests."
  canonicalPath="/services/asian-wedding-catering"
  schemas={schemas}
>
  <PageHero
    eyebrow="HMC-Certified Halal • Authentic South Asian Cuisine"
    title="Asian Wedding Catering"
    highlight="in London, Essex & Kent"
    subtitle="Slow-cooked Bengali, Pakistani, and Indian wedding banquets served hot for 50 to 1,000+ guests — starting from £25 per person with crockery, cutlery, and professional waiting staff included."
    image={headerCatering}
    imageAlt="Luxury Halal Asian wedding catering spread in London by Salwah Events"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="#quote-form"
    primaryCtaLabel="Request a Catering Quote"
  />

  <!-- Quick Facts + Inline High-Converting Quote Form -->
  <section class="py-14 sm:py-16 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-8">
          <QuickFactsBox
            heading="Asian Wedding Catering: Key Facts"
            summary="Salwah Events and Catering delivers full-service 100% HMC Certified Halal wedding catering across Greater London, Essex, and Kent — combining heritage South Asian flavours with five-star hospitality."
            facts={quickFacts}
          />

          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold">
            <h2>100% HMC Certified Halal Excellence</h2>
            <p>
              For South Asian and Muslim families, Halal integrity is non-negotiable. Every cut of
              lamb, beef, and chicken we prepare is sourced exclusively from{' '}
              <strong>HMC-certified suppliers</strong>, cooked in our dedicated Edmonton, London
              production kitchen (N18 1UB), and served by uniformed staff trained in traditional
              hospitality.
            </p>
            <p>
              Complete your reception with chilled fruit mocktails, Bengali spiced borhani, Kashmiri
              pink chai, freshly brewed cardamom karak chai, and artisan coffee.
            </p>

            <h2>Three Heritage Cuisines Under One Roof</h2>
            <p>
              Many modern British Asian weddings bring together different cultural traditions. Our
              specialist chefs craft bespoke menus across Bengali, Pakistani, and Indian cuisines —
              so you can honour every side of the family without compromise:
            </p>
            <ul>
              <li>
                <strong><a href="/bengali-wedding-catering-london">Bengali / Bangladeshi Wedding Catering</a>:</strong>{' '}
                Dhakai lamb kacchi biryani, slow-cooked beef kala bhuna, traditional shahi chicken
                roast, beef rezala, borthas, borhani, roshmalai, and mishti doi.
              </li>
              <li>
                <strong><a href="/pakistani-wedding-catering-london">Pakistani Wedding Catering</a>:</strong>{' '}
                Complete Nikah, Mehndi, Baraat, and Walima feasts featuring Peshawari chapli kebabs,
                lamb karahi gosht, slow-simmered nihari, seekh kebabs, dum biryani, and warm gajar halwa.
              </li>
              <li>
                <strong><a href="/indian-wedding-catering-london">Indian Wedding Catering</a>:</strong>{' '}
                Butter chicken makhni, tandoori malai tikka, Hyderabadi biryani, live papri &amp;
                pani puri chaat counters, vibrant vegetarian paneer &amp; daal dishes, and gulab jamun.
              </li>
            </ul>
          </div>

          <div class="rounded-2xl overflow-hidden border border-salwah-gold/20">
            <Picture
              src={cateringBuffet}
              alt="Halal Asian wedding buffet service in London by Salwah Events"
              widths={[480, 800]}
              sizes="(max-width: 1024px) 100vw, 58vw"
              formats={['webp']} fallbackFormat="webp" quality={78}
              loading="lazy"
              class="w-full h-72 sm:h-80 object-cover"
            />
          </div>

          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold">
            <h2>Flexible Service Styles for Every Venue</h2>
            <p>
              Whether you are hosting an intimate 50-guest Nikah at home or a 1,000-guest Walima at{' '}
              <a href="/services/venues-locations">The City Pavilion, Meridian Grand, or The Willows</a>,
              our floor supervisors manage piping-hot service around your exact schedule:
            </p>
            <ul>
              <li>
                <strong>Family-Style Table Service:</strong> Generous serving bowls placed directly
                at every table so elders and guests dine comfortably without queueing.
              </li>
              <li>
                <strong>Grand Multi-Station Buffet:</strong> Multiple parallel buffet lines staffed
                by servers to serve 300–1,000+ guests swiftly while keeping food hot and crisp.
              </li>
              <li>
                <strong>Plated Fine Dining:</strong> Elegant individually plated starters, mains, and
                desserts ideal for formal receptions and dry-hire estates across{' '}
                <a href="/halal-wedding-catering-essex-kent">Essex &amp; Kent</a>.
              </li>
              <li>
                <strong>Interactive Live Stations:</strong> Live tandoori grill counters, street-food
                chaat bars, luxury dessert displays, and freshly poured karak chai stations.
              </li>
            </ul>
          </div>
        </div>

        <aside class="lg:col-span-5 lg:sticky lg:top-28 space-y-6" id="quote-form">
          <QuoteForm
            client:visible
            variant="compact"
            sourcePage="Asian Wedding Catering LP"
            defaultService="Halal Wedding Catering"
            heading="Sample Our Wedding Menus"
            subheading="Request bespoke per-head pricing & arrange a menu consultation in London."
          />

          <div class="mt-6 rounded-2xl border border-salwah-gold/20 bg-[#101219] p-6 space-y-4">
            <h3 class="font-serif text-xl font-bold text-salwah-gold">
              Popular Package Starting Prices
            </h3>
            <div class="space-y-3">
              {
                PACKAGES.map((pkg) => (
                  <div class="flex items-center justify-between border-b border-white/10 pb-3 last:border-b-0 last:pb-0">
                    <div>
                      <p class="font-semibold text-white text-sm">{pkg.name}</p>
                      <p class="text-xs text-gray-400">{pkg.unit}</p>
                    </div>
                    <span class="font-serif text-xl font-bold text-salwah-gold">{pkg.price}</span>
                  </div>
                ))
              }
            </div>
            <div class="pt-2 flex flex-wrap gap-3 text-xs font-semibold">
              <a href="/packages" class="text-salwah-gold hover:underline">View Full Packages &rarr;</a>
              <a href="/menu" class="text-salwah-gold hover:underline">Explore Full Menu &rarr;</a>
              <a href="/resources/quote-builder" class="text-salwah-gold hover:underline">Build Custom Quote PDF &rarr;</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Dedicated Cuisine Landing Pages Cross-Links -->
  <section class="py-14 bg-salwah-surface border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white text-center mb-8">
        Explore Our Specialist <span class="text-salwah-gold">Wedding Catering Menus</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/bengali-wedding-catering-london" class="group luxury-card rounded-2xl overflow-hidden">
          <Picture src={menuBiryani} alt="Bengali wedding kacchi biryani" widths={[480, 800]} formats={['webp']} fallbackFormat="webp" quality={78} loading="lazy" class="h-44 w-full object-cover group-hover:scale-105 transition duration-500" />
          <div class="p-5">
            <h3 class="font-serif text-xl font-bold text-white group-hover:text-salwah-gold">Bengali Wedding Catering London</h3>
            <p class="mt-2 text-sm text-gray-300">Kacchi biryani, beef kala bhuna, chicken roast, borthas, borhani &amp; roshmalai.</p>
          </div>
        </a>
        <a href="/pakistani-wedding-catering-london" class="group luxury-card rounded-2xl overflow-hidden">
          <Picture src={menuMains} alt="Pakistani wedding catering London" widths={[480, 800]} formats={['webp']} fallbackFormat="webp" quality={78} loading="lazy" class="h-44 w-full object-cover group-hover:scale-105 transition duration-500" />
          <div class="p-5">
            <h3 class="font-serif text-xl font-bold text-white group-hover:text-salwah-gold">Pakistani Wedding Catering London</h3>
            <p class="mt-2 text-sm text-gray-300">Nikah, Mehndi, Baraat &amp; Walima banquets with karahi, nihari &amp; chapli kebabs.</p>
          </div>
        </a>
        <a href="/indian-wedding-catering-london" class="group luxury-card rounded-2xl overflow-hidden">
          <Picture src={menuStarters} alt="Indian wedding catering London" widths={[480, 800]} formats={['webp']} fallbackFormat="webp" quality={78} loading="lazy" class="h-44 w-full object-cover group-hover:scale-105 transition duration-500" />
          <div class="p-5">
            <h3 class="font-serif text-xl font-bold text-white group-hover:text-salwah-gold">Indian Wedding Catering London</h3>
            <p class="mt-2 text-sm text-gray-300">Live tandoor, chaat stations, rich curries &amp; dedicated vegetarian/vegan feasts.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <CtaBanner
    title="Ready to Plan Your"
    highlight="Halal Wedding Feast?"
    subtitle="Share your date, guest count, and favourite dishes. We will reply promptly with clear per-head pricing from £25pp and arrange a complimentary menu consultation."
    primaryHref="#quote-form"
    primaryLabel="Get Your Free Catering Quote"
  />
</BaseLayout>
