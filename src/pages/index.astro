---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrustBadges from '@/components/TrustBadges.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';
import InstantQuoteEstimator from '@/components/InstantQuoteEstimator';
import WeddingExperienceShowcase, { type ShowcaseSlide } from '@/components/WeddingExperienceShowcase';

import heroCouple from '@/assets/images/hero-couple.jpg';
import serviceCatering from '@/assets/images/home-service-catering.jpg';
import serviceStage from '@/assets/images/home-service-stage.jpg';
import servicePlanning from '@/assets/images/home-service-planning.jpg';
import menuBiryani from '@/assets/images/menu-biryani.png';
import menuMains from '@/assets/images/menu-mains.png';
import menuStarters from '@/assets/images/menu-starters.png';
import menuDesserts from '@/assets/images/menu-desserts.png';
import galleryMocktails from '@/assets/images/gallery-catering-platters.png';
import galleryDessertDisplay from '@/assets/images/gallery-dessert-display.png';
import galleryStageFloral from '@/assets/images/gallery-stage-floral.jpg';
import headerAsianCatering from '@/assets/images/header-asian-catering.png';

import { SITE } from '@/data/site';
import { PACKAGES } from '@/data/packages';
import { PARTNER_VENUE_NAMES } from '@/data/venues';
import { TESTIMONIALS } from '@/data/testimonials';
import {
  buildFaqSchema,
  buildOfferCatalogSchema,
  buildServiceSchema,
  type FaqItem,
} from '@/lib/schema';

// Pre-optimize showcase imagery to crisp WebP so client island stays ultra-lightweight
const [optFeast, optStage, optLounge, optDesserts] = await Promise.all([
  getImage({ src: headerAsianCatering, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: serviceStage, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: galleryMocktails, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: galleryDessertDisplay, width: 1000, format: 'webp', quality: 80 }),
]);

const showcaseSlides: ShowcaseSlide[] = [
  {
    id: 'royal-feast',
    tabLabel: '01 • The Royal Feast',
    eyebrow: '100% HMC Certified Halal Banquets',
    title: 'Piping-Hot Heritage Cuisine Served With White-Glove Precision',
    description:
      'From fragrant Dhakai Lamb Kacchi Biryani sealed on dum to sizzling charcoal seekh kebabs, Beef Kala Bhuna, and slow-cooked Lamb Karahi — every dish is cooked fresh in our dedicated London Halal kitchen for 50 to 1,000+ guests.',
    highlights: [
      'Authentic Bengali, Pakistani & Indian regional spice mastery',
      'Grand buffet, family-style table service, or plated fine dining',
      'Uniformed brigade, fine crockery, glassware & full floor supervision',
    ],
    imageSrc: optFeast.src,
    imageAlt: 'Grand candlelit London Asian wedding banquet buffet with copper chafing dishes',
    serviceTarget: 'Halal Wedding Catering',
    ctaLabel: 'Add Banquet Catering to Quote',
    href: '/menu',
  },
  {
    id: 'dream-stage',
    tabLabel: '02 • Bespoke Floral Stages',
    eyebrow: 'Custom Ballroom & Ceremony Design',
    title: 'Show-Stopping Wedding Stages Engineered for Unforgettable Photos',
    description:
      'Transform any London ballroom, hotel suite, or marquee with lush ivory and crimson florals, scalloped gold backdrops, crystal chandelier accents, serene Nikah partitions, and vibrant Mehndi or Gaye Holud setups.',
    highlights: [
      'Measured and designed specifically for your venue proportions',
      'Coordinated sweetheart seating, mirrored walkways & table centrepieces',
      'Seamless one-team load-in alongside our catering crew',
    ],
    imageSrc: optStage.src,
    imageAlt: 'Bespoke ivory and gold floral Asian wedding stage decoration with baroque sofa',
    serviceTarget: 'Wedding Stage Decor',
    ctaLabel: 'Add Stage Decor to Quote',
    href: '/services/wedding-stage-decoration',
  },
  {
    id: 'mocktail-chai',
    tabLabel: '03 • Mocktail & Karak Chai Lounge',
    eyebrow: 'Elevated Welcome Hospitality',
    title: 'Handcrafted Fruit Mocktails, Spiced Borhani & Pouring Karak Chai',
    description:
      'Delight guests from the moment they step through the doors with vibrant mango passionfruit coolers, mint-lime spritzers, authentic Bengali spiced borhani, and steaming brass kettles of cardamom karak chai.',
    highlights: [
      'Bespoke welcome drink receptions tailored to your wedding colours',
      'Live Kashmiri pink chai & cardamom karak chai pouring stations',
      'Ideal for Mehndi nights, Nikah receptions & grand Walimas',
    ],
    imageSrc: optLounge.src,
    imageAlt: 'Handcrafted fruit mocktails, spiced borhani, and freshly poured karak chai station',
    serviceTarget: 'Both Catering & Stage Decor',
    ctaLabel: 'Add Drinks & Chai Station',
    href: '/menu#mocktails-chai',
  },
  {
    id: 'mithai-table',
    tabLabel: '04 • Mithai & Dessert Display',
    eyebrow: 'Grand Finale Sweet Tables',
    title: 'Artisan South Asian Desserts That Keep Guests Talking Long After Rukhsati',
    description:
      'Crown your feast with warm gulab jamun paired with vanilla bean ice cream, chilled saffron roshmalai, slow-caramelised gajar halwa, pistachio baklava, and opulent multi-tiered mithai grazing tables.',
    highlights: [
      'Served warm to every table or styled as a dramatic live dessert display',
      'Traditional Bengali mishti doi, firni, zarda & luxury milk cakes',
      'Full allergen labelling and egg-free / nut-aware options available',
    ],
    imageSrc: optDesserts.src,
    imageAlt: 'Luxury tiered Asian wedding dessert display featuring baklava, mithai and warm sweets',
    serviceTarget: 'Halal Wedding Catering',
    ctaLabel: 'Add Dessert Display to Quote',
    href: '/menu#desserts',
  },
];

const homeFaqs: FaqItem[] = [
  {
    question: 'How much does Asian wedding catering cost per person in London?',
    answer:
      'Salwah Events Halal Asian wedding catering packages start from £30 per person for our Silver Package (2 starters, 3 mains, pilau rice, naan, salad, dessert, crockery, and waiting staff), £45 per person for our popular Gold Package (with welcome mocktails and grilled starters), and from £17,500 all-inclusive for our Platinum catering, stage decor, and full event management package for 200 guests.',
  },
  {
    question: 'Is all food at Salwah Events 100% HMC Certified Halal?',
    answer:
      'Yes. Every single dish we serve is prepared with 100% HMC Certified Halal meat and poultry in our dedicated London Halal kitchens. We also provide gourmet welcome mocktails, traditional Bengali borhani, freshly brewed karak chai, and artisan coffee.',
  },
  {
    question: 'How many guests can Salwah Events cater for?',
    answer:
      'We cater for intimate Nikah and Mehndi gatherings starting from 50 guests right up to grand Asian wedding banquets and Walimas for 1,000+ guests across Greater London, Essex, and Kent.',
  },
  {
    question: 'Which South Asian wedding cuisines do you specialise in?',
    answer:
      'Our culinary team prepares authentic Bengali (Bangladeshi), Pakistani, and Indian Halal wedding menus — including Dhakai Lamb Kacchi Biryani, Beef Kala Bhuna, Chicken Roast, Lamb Karahi, Chapli Kebabs, Nihari, Live Chaat Stations, Roshmalai, and Warm Gulab Jamun.',
  },
  {
    question: 'Can we arrange a menu consultation or food sampling before booking?',
    answer:
      'Yes! Contact our team by phone, WhatsApp, or our quick quote form to book a complimentary menu consultation and arrange food sampling of our signature wedding dishes tailored to your guest count and budget.',
  },
  {
    question: 'Do you cater at dry-hire venues, hotels, and marquees across London, Essex, and Kent?',
    answer:
      'Yes. We bring full mobile finishing equipment, chafing stations, fine crockery, cutlery, glassware, and uniformed staff to dry-hire halls, 5-star hotels, estates, and marquees across East London, North London, West London, South London, Essex, and Kent.',
  },
];

const cuisineAndCeremonyHubs = [
  {
    title: 'Bengali Wedding Catering',
    tag: 'Sylheti & Dhakai Heritage',
    href: '/bengali-wedding-catering-london',
    blurb: 'Dhakai kacchi biryani, beef kala bhuna, chicken roast, traditional borthas, spiced borhani & roshmalai.',
    image: menuBiryani,
    alt: 'Traditional Bengali kacchi biryani wedding catering in London',
  },
  {
    title: 'Pakistani Wedding Catering',
    tag: 'Nikah, Baraat & Walima',
    href: '/pakistani-wedding-catering-london',
    blurb: 'Complete multi-day feasts featuring lamb karahi, slow-cooked nihari, chapli kebabs & live karak chai.',
    image: menuMains,
    alt: 'Authentic Pakistani wedding catering curries and grills in London',
  },
  {
    title: 'Indian Wedding Catering',
    tag: 'North & South Indian Halal',
    href: '/indian-wedding-catering-london',
    blurb: 'Chargrilled tandoori platters, live chaat counters, royal curries, and vibrant vegetarian/vegan spreads.',
    image: menuStarters,
    alt: 'Halal Indian wedding starters and tandoori catering in London',
  },
  {
    title: 'Nikah & Walima Catering',
    tag: '50 to 1,000+ Guests',
    href: '/nikah-walima-catering-london',
    blurb: 'Dignified Nikah backdrops, Sunnah hospitality, and grand chandelier-lit Walima banquets across London.',
    image: heroCouple,
    alt: 'Nikah and Walima Asian wedding catering in London',
  },
  {
    title: 'Mehndi & Gaye Holud',
    tag: 'Live Street-Food Counters',
    href: '/mehndi-gaye-holud-catering-london',
    blurb: 'Interactive papri chaat, golgappa, sizzling grill stations, fresh jalebi, karak chai & marigold decor.',
    image: galleryMocktails,
    alt: 'Mehndi and Gaye Holud catering with live mocktails and chai in London',
  },
  {
    title: 'Dry-Hire, Hotel & Marquee',
    tag: 'Full Mobile Kitchen Brigade',
    href: '/dry-hire-asian-wedding-catering-london',
    blurb: 'Turnkey catering, fine crockery, glassware & uniformed service for dry-hire estates, hotels & marquees.',
    image: servicePlanning,
    alt: 'Dry-hire Asian wedding banquet tablescape in London',
  },
];

const regionalHubs = [
  {
    region: 'East London',
    towns: 'Ilford • Romford • Newham • Tower Hamlets • Redbridge • Barking • Wanstead • Stratford',
    href: '/halal-wedding-catering-east-london',
    blurb: 'Trusted across The City Pavilion, The Willows, Mayfair Venue, The Royal Regency, Palm Tree & Oasis.',
  },
  {
    region: 'North & West London',
    towns: 'Edmonton (HQ) • Enfield • Barnet • Finchley • Harrow • Wembley • Southall • Ealing',
    href: '/halal-wedding-catering-north-west-london',
    blurb: 'Minutes from Meridian Grand & Ariana Banqueting Hall, plus Osterley Park & Syon Park dry-hire setups.',
  },
  {
    region: 'Essex & Kent',
    towns: 'Chigwell • Loughton • Brentwood • Chelmsford • Dartford • Gravesend • Sevenoaks • Maidstone',
    href: '/halal-wedding-catering-essex-kent',
    blurb: 'Dedicated refrigerated fleets and mobile finishing kitchens for country houses, barns & garden marquees.',
  },
];

const coreServices = [
  {
    title: 'Asian Wedding Catering',
    href: '/services/asian-wedding-catering',
    description:
      '100% HMC Certified Halal Bengali, Pakistani, and Indian wedding banquets with uniformed waiting staff and plated or buffet dining.',
    image: serviceCatering,
    alt: 'Halal Asian wedding catering table service in London',
  },
  {
    title: 'Wedding Stage Decoration',
    href: '/services/wedding-stage-decoration',
    description:
      'Bespoke floral backdrops, Nikah & Mehndi stages, sweetheart seating, walkways, centrepieces, and architectural mood lighting.',
    image: serviceStage,
    alt: 'Bespoke floral Asian wedding stage decoration in London',
  },
  {
    title: 'Full Event Management',
    href: '/services/event-management-planning',
    description:
      'End-to-end timelines, venue sourcing, supplier coordination, and dedicated on-the-day management for a calm celebration.',
    image: servicePlanning,
    alt: 'Luxury Asian wedding planning and on-the-day event management',
  },
];

const weddingJourney = [
  {
    step: '01',
    title: 'Complimentary Menu Consultation',
    detail:
      'Tell us your date, guest count, venue, and cultural traditions. We send clear transparent pricing from £30pp within hours.',
  },
  {
    step: '02',
    title: 'Food Sampling & Stage Moodboard',
    detail:
      'Sample our signature 100% HMC Halal dishes with your family, fine-tune spice levels, and preview your bespoke floral stage design.',
  },
  {
    step: '03',
    title: 'Venue Walkthrough & Run-Sheet Lock',
    detail:
      'Our event manager coordinates directly with your banqueting hall or dry-hire estate on load-in, kitchen prep, and exact serving timings.',
  },
  {
    step: '04',
    title: 'White-Glove Wedding Execution',
    detail:
      'Relax and celebrate with your loved ones while our chefs serve piping-hot dishes and our uniformed team manages every single detail.',
  },
];

const quickFacts = [
  { label: 'Starting Price', value: 'From £30 per person (Silver), £45pp (Gold), £17,500 all-inclusive (Platinum)' },
  { label: 'Guest Capacity', value: '50 to 1,000+ guests (Nikah, Mehndi, Gaye Holud, Baraat, Walima & Corporate)' },
  { label: 'Halal Certification', value: '100% HMC Certified Halal Dedicated London Kitchen (Edmonton N18)' },
  { label: 'Cuisines Offered', value: 'Bengali / Bangladeshi, Pakistani, North & South Indian & Fusion' },
  { label: 'Service Styles', value: 'Grand Buffet, Family-Style Table Service, Plated Fine Dining & Live Stations' },
  { label: 'Areas Covered', value: 'Greater London (East, North, West & South), Essex & Kent' },
];

const schemas = [
  buildServiceSchema({
    name: 'Halal Asian Wedding Catering & Event Services',
    serviceType: 'Halal Wedding Catering, Stage Decoration & Event Management',
    description:
      'Luxury 100% HMC Certified Halal Asian wedding catering (Bengali, Pakistani & Indian) and bespoke wedding stage decoration across Greater London, Essex, and Kent.',
    url: '/',
  }),
  buildOfferCatalogSchema(),
  buildFaqSchema(homeFaqs),
];
---

<BaseLayout
  title="Luxury Asian Wedding Catering London & Stage Decor | Salwah Events"
  description="Luxury 100% HMC Certified Halal Asian wedding catering (Bengali, Pakistani & Indian) & bespoke stage decor in London, Essex & Kent. Packages from £30pp for 50–1,000+ guests."
  canonicalPath="/"
  schemas={schemas}
>
  <!-- 1. Editorial Split Luxury Hero (Couple 100% Visible & Unobstructed) -->
  <section class="relative overflow-hidden obsidian-glow border-b border-salwah-gold/25">
    <div
      class="pointer-events-none absolute -top-24 right-0 h-[420px] w-[420px] rounded-full bg-salwah-gold/10 blur-[120px]"
      aria-hidden="true"
    />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-9 sm:py-12 lg:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Timeless Editorial Copy & High-Intent CTAs -->
        <div class="lg:col-span-6 text-left">
          <p class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.22em] text-salwah-gold mb-3.5">
            <span class="h-px w-6 bg-salwah-gold/75 shrink-0" aria-hidden="true" />
            London • Essex • Kent • Bespoke Weddings
          </p>
          <h1 class="font-serif text-4xl sm:text-5xl xl:text-[3.5rem] font-bold tracking-tight text-white leading-[1.06]">
            Luxury <span class="gold-gradient-text italic font-semibold">Asian Wedding</span> Catering &amp; Stage Decor
          </h1>
          <p class="mt-4 text-base sm:text-lg text-gray-200/95 max-w-xl leading-relaxed">
            Unforgettable Bengali, Pakistani, and Indian wedding feasts paired with breathtaking
            floral stage design — <strong>100% HMC Certified Halal</strong>, crafted fresh in London
            for <strong>50 to 1,000+ guests</strong> starting from <strong>£30 per person</strong>.
          </p>

          <div class="mt-5">
            <TrustBadges align="left" />
          </div>

          <div class="mt-7 flex flex-col sm:flex-row flex-wrap gap-2.5">
            <a
              href="#quote-form"
              class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-5 py-3.5 text-sm sm:text-[15px] font-bold whitespace-nowrap"
            >
              Get Your Free Quote
            </a>
            <a
              href="#instant-estimator"
              class="inline-flex items-center justify-center rounded-xl border border-salwah-gold/55 bg-black/55 backdrop-blur-md px-5 py-3.5 text-sm sm:text-[15px] font-semibold text-salwah-gold hover:bg-salwah-gold hover:text-black transition whitespace-nowrap"
            >
              Estimate Your Price
            </a>
            <a
              href={SITE.whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-xl bg-[#25D366] px-5 py-3.5 text-sm sm:text-[15px] font-bold text-black hover:brightness-105 transition shadow-lg shadow-[#25D366]/20 whitespace-nowrap"
            >
              WhatsApp Us
            </a>
          </div>
        </div>

        <!-- Right: Full Unobstructed Radiant Couple Portrait -->
        <div class="lg:col-span-6">
          <div class="relative rounded-3xl editorial-frame overflow-hidden bg-black aspect-[4/3] sm:aspect-[16/11] lg:aspect-[5/4] shadow-2xl">
            <Picture
              src={heroCouple}
              alt="Joyful South Asian bride and groom celebrating inside a candlelit luxury London ballroom catered by Salwah Events"
              widths={[640, 1280]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              formats={['webp']}
              fallbackFormat="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="h-full w-full object-cover object-[56%_22%]"
            />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
            <div class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full border border-salwah-gold/45 bg-black/70 backdrop-blur-md px-3.5 py-1.5 text-xs font-semibold text-salwah-gold">
                Bespoke Banquets &amp; Floral Stages
              </span>
              <span class="rounded-full border border-white/20 bg-black/70 backdrop-blur-md px-3.5 py-1.5 text-xs font-medium text-gray-100">
                50 – 1,000+ Guests • From £30pp
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Architectural 4-Pillar Luxury Credentials Bar -->
  <section class="bg-[#090a0f] border-b border-salwah-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0 lg:divide-x lg:divide-salwah-gold/20 text-center">
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">100% HMC</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Certified Dedicated Halal Kitchen</p>
        </div>
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">From £30pp</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Transparent Per-Head Packages</p>
        </div>
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">50 – 1,000+</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Intimate Nikah to Grand Walima</p>
        </div>
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">5.0★ Rated</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">London, Essex &amp; Kent Families</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Interactive Luxury Wedding Experience Showcase -->
  <section class="py-18 sm:py-24 obsidian-glow" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-salwah-gold mb-2.5">
          The Salwah Experience
        </p>
        <div class="ornamental-divider mb-4" aria-hidden="true">
          <span class="ornamental-diamond" />
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
          Every Moment Crafted to <span class="gold-gradient-text italic font-semibold">Captivate Your Guests</span>
        </h2>
        <p class="mt-4 text-gray-300 text-base sm:text-lg">
          Explore the four signature pillars that turn a London wedding into an unforgettable family milestone.
        </p>
      </div>

      <WeddingExperienceShowcase client:visible slides={showcaseSlides} />
    </div>
  </section>

  <!-- 4. Mouth-Watering Culinary & Bridal Bento Lookbook -->
  <section class="py-18 sm:py-22 velvet-section border-y border-salwah-gold/15" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-salwah-gold mb-2">
            Visual Culinary &amp; Decor Lookbook
          </p>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
            A Feast for the Eyes — <span class="gold-gradient-text italic font-semibold">Before the First Bite</span>
          </h2>
        </div>
        <div class="flex items-center gap-5 shrink-0">
          <a href="/menu" class="text-sm font-bold text-salwah-gold hover:underline">
            Explore Full Menu &rarr;
          </a>
          <a href="/gallery" class="text-sm font-semibold text-gray-300 hover:text-salwah-gold transition">
            View Gallery &rarr;
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Large Left Showcase: Kacchi Biryani -->
        <a
          href="/menu#rice-biryani"
          class="group md:col-span-7 relative overflow-hidden rounded-2xl editorial-frame min-h-[280px] sm:min-h-[360px]"
        >
          <Picture
            src={menuBiryani}
            alt="Steaming saffron Dhakai Lamb Kacchi Biryani served in hammered copper deg"
            widths={[480, 800]}
            sizes="(max-width: 768px) 100vw, 58vw"
            formats={['webp']}
            fallbackFormat="webp"
            quality={80}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent p-6 sm:p-7 flex flex-col justify-end">
            <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-salwah-gold">Signature Centrepiece</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1 group-hover:text-salwah-gold transition">
              Traditional Dhakai Lamb Kacchi Biryani
            </h3>
            <p class="mt-1.5 text-sm text-gray-200 max-w-lg">
              Aged saffron basmati slow-sealed on dum with tender HMC Halal lamb, caramelised onions, and whole aromatic spices.
            </p>
          </div>
        </a>

        <!-- Right Top: Crimson & Gold Wedding Stage -->
        <a
          href="/services/wedding-stage-decoration"
          class="group md:col-span-5 relative overflow-hidden rounded-2xl editorial-frame min-h-[280px] sm:min-h-[360px]"
        >
          <Picture
            src={galleryStageFloral}
            alt="Luxury crimson and ivory floral Asian wedding stage decoration in London"
            widths={[480, 800]}
            sizes="(max-width: 768px) 100vw, 42vw"
            formats={['webp']}
            fallbackFormat="webp"
            quality={80}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent p-6 flex flex-col justify-end">
