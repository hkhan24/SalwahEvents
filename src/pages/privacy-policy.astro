---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/data/site';

const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Privacy Policy' }];
---

<BaseLayout
  title="Privacy Policy | Salwah Events and Catering"
  description="How Salwah Events and Catering (Salwah Events Ltd) collects, uses, and protects your personal information."
  canonicalPath="/privacy-policy"
  noindex={true}
>
  <section class="py-14 sm:py-20 bg-salwah-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 font-serif text-4xl sm:text-5xl font-bold text-white mb-6">
        Privacy <span class="text-salwah-gold">Policy</span>
      </h1>

      <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold text-gray-300">
        <p>Last updated: November 2026</p>

        <h2>1. Who We Are</h2>
        <p>
          <strong>{SITE.businessName}</strong> ({SITE.legalName}, Companies House No.{' '}
          {SITE.companiesHouseNo}, VAT No. {SITE.vatNo}) is registered at {SITE.address.full}. We
          are committed to protecting your personal data under UK GDPR and the Data Protection Act
          2018.
        </p>

        <h2>2. Information We Collect</h2>
        <p>
          When you submit a quote enquiry or contact us by phone, WhatsApp, or email, we collect
          details you provide such as your name, email address, telephone number, event date,
          estimated guest count, venue/location, and event notes. We also collect anonymised site
          performance and conversion analytics via Google Tag Manager and Google Ads tags.
        </p>

        <h2>3. How We Use Your Information</h2>
        <ul>
          <li>Respond to your catering, decor, or event planning enquiries and issue quotes.</li>
          <li>Coordinate menu consultations, food sampling, and event delivery.</li>
          <li>Improve our website performance, customer service, and advertising relevance.</li>
        </ul>

        <h2>4. Data Sharing &amp; Storage</h2>
        <p>
          We never sell or rent your personal information. Form enquiries are transmitted securely
          via Web3Forms solely to deliver your message to our team. Free wedding planning tools on
          our Resources pages process all inputs locally inside your own browser.
        </p>

        <h2>5. Your Rights &amp; Contact</h2>
        <p>
          You may request access to, correction of, or deletion of your personal data at any time
          by emailing <a href={SITE.emailHref}>{SITE.email}</a> or calling{' '}
          <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
