---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/data/site';

const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Cookie Notice' }];
---

<BaseLayout
  title="Cookie Notice | Salwah Events and Catering"
  description="Cookie Notice explaining how Salwah Events and Catering uses essential, analytics, and advertising measurement cookies."
  canonicalPath="/cookie-notice"
  noindex={true}
>
  <section class="py-14 sm:py-20 bg-salwah-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 font-serif text-4xl sm:text-5xl font-bold text-white mb-6">
        Cookie <span class="text-salwah-gold">Notice</span>
      </h1>

      <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold text-gray-300">
        <p>Last updated: November 2026</p>

        <h2>1. What Are Cookies?</h2>
        <p>
          Cookies are small text files stored on your device when you visit a website. They help
          sites remember preferences and measure how visitors interact with pages.
        </p>

        <h2>2. Cookies We Use</h2>
        <ul>
          <li>
            <strong>Essential &amp; Functional Storage:</strong> Remembers your cookie banner choice
            and supports browser-based wedding planning tools.
          </li>
          <li>
            <strong>Analytics &amp; Conversion Measurement:</strong> We use Google Tag Manager and
            Google Ads conversion tags to understand how visitors find our services and measure
            enquiry performance.
          </li>
        </ul>

        <h2>3. Managing Your Preferences</h2>
        <p>
          You can accept or decline cookies through our banner or control cookies directly within
          your browser settings. For questions, email <a href={SITE.emailHref}>{SITE.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
