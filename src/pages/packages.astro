---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';

import headerPackages from '@/assets/images/header-packages.png';
import { PACKAGES, PACKAGE_COMPARISON } from '@/data/packages';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Wedding Packages' },
];

const faqs: FaqItem[] = [
  {
    question: 'What is included in the £30 per person Silver catering package?',
    answer:
      'Our Silver Package (£30 per person) includes 2 starters, 3 main courses (chicken, lamb, and vegetarian), pilau rice, naan bread, salad & chutneys, 1 dessert, full crockery & cutlery, and uniformed waiting staff — 100% HMC Certified Halal.',
  },
  {
    question: 'What makes the £45 per person Gold Package your most popular choice?',
    answer:
      'The Gold Package (£45pp) upgrades your menu to 3 starters including chargrilled kebabs, 4 premium main courses, biryani & pilau rice, full salad bar, 2 luxury desserts, welcome mocktails, full crockery/glassware, and an experienced floor supervisor.',
  },
  {
    question: 'Does the Platinum Package include both catering and wedding stage decoration?',
    answer:
      'Yes! Starting from £17,500 for 200 guests (and fully scalable up to 1,000+ guests), the Platinum Package combines our complete Gold Halal catering menu with bespoke luxury wedding stage decoration, venue lighting, table centrepieces, a live dessert/chai or paan stall, and full event management.',
  },
  {
    question: 'Can we customise a package for 50 guests or 800+ guests?',
    answer:
      'Absolutely. Every package scales seamlessly from 50 to 1,000+ guests, and you can add live chaat stations, karak chai stalls, borhani service, or stage styling to any tier.',
  },
];

const quickFacts = [
  { label: 'Silver Package', value: '£30 per person — 2 Starters, 3 Mains, Rice/Naan, 1 Dessert & Staff' },
  { label: 'Gold Package (Popular)', value: '£45 per person — 3 Starters (Grills), 4 Mains, 2 Desserts & Welcome Mocktails' },
  { label: 'Platinum All-Inclusive', value: 'From £17,500 (200 guests) — Gold Catering + Luxury Stage Decor & Management' },
  { label: 'Guest Capacity', value: '50 to 1,000+ guests across Greater London, Essex & Kent' },
  { label: 'Halal Guarantee', value: '100% HMC Certified Halal Dedicated Kitchen' },
  { label: 'Interactive Estimator', value: 'Use our free Quote Builder or Budget Calculator anytime' },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildServiceSchema({
    name: 'Asian Wedding Catering Packages London',
    serviceType: 'Halal Wedding Catering Packages',
    description:
      'Transparent 100% HMC Certified Halal Asian wedding catering packages in London, Essex & Kent: Silver (£30pp), Gold (£45pp), and Platinum all-inclusive catering + stage decor (from £17,500).',
    url: '/packages',
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="Asian Wedding Catering Packages London | From £30pp | Salwah Events"
  description="Transparent 100% HMC Certified Halal Asian wedding catering packages in London, Essex & Kent: Silver (£30pp), Gold (£45pp), and all-inclusive Platinum catering + stage decor from £17,500."
  canonicalPath="/packages"
  schemas={schemas}
>
  <PageHero
    eyebrow="Transparent Pricing • 50 to 1,000+ Guests"
    title="Asian Wedding"
    highlight="Catering Packages"
    subtitle="Choose from our clear per-person Silver and Gold Halal catering packages, or go completely stress-free with our all-inclusive Platinum catering, stage decor, and full event management package."
    image={headerPackages}
    imageAlt="Luxury Asian wedding catering packages table setup in London"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="#quote-form"
    primaryCtaLabel="Request Custom Proposal"
  />

  <section class="py-12 sm:py-16 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <QuickFactsBox
        heading="Package Pricing at a Glance"
        summary="All Salwah Events catering packages include 100% HMC Certified Halal cuisine, fresh preparation, and uniformed hospitality staff."
        facts={quickFacts}
      />

      <!-- 3 Tier Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        {
          PACKAGES.map((pkg) => (
            <div
              class={`relative rounded-2xl p-8 flex flex-col ${
                pkg.id === 'gold'
                  ? 'package-gold lg:-translate-y-2'
                  : pkg.id === 'platinum'
                    ? 'package-platinum'
                    : 'package-silver'
              }`}
            >
              {pkg.popular && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-salwah-gold px-4 py-1 text-xs font-bold uppercase tracking-wider text-black shadow">
                  Most Popular Choice
                </span>
              )}

              <div class="text-center pb-6 border-b border-white/10">
                <h2 class="font-serif text-3xl font-bold text-white">{pkg.name}</h2>
                <div class="mt-3 flex items-baseline justify-center gap-1.5">
                  <span class="font-serif text-4xl sm:text-5xl font-bold text-salwah-gold">{pkg.price}</span>
                  <span class="text-sm text-gray-300">{pkg.unit}</span>
                </div>
                <p class="mt-3 text-sm text-gray-300">{pkg.tagline}</p>
              </div>

              <ul class="mt-6 space-y-3 text-sm text-gray-200 flex-1">
                {pkg.features.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-salwah-gold font-bold mt-0.5 shrink-0" aria-hidden="true">&#10003;</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <p class="mt-6 text-xs text-gray-400 italic text-center">{pkg.summary}</p>

              <a
                href="#quote-form"
                class={`mt-6 inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold transition ${
                  pkg.popular
                    ? 'bg-salwah-gold text-black hover:bg-salwah-gold-light'
                    : 'border border-salwah-gold/50 text-salwah-gold hover:bg-salwah-gold hover:text-black'
                }`}
              >
                Enquire for {pkg.name}
              </a>
            </div>
          ))
        }
      </div>

      <!-- Comparison Table -->
      <div class="rounded-2xl border border-salwah-gold/25 bg-[#0e1017] p-5 sm:p-8">
        <div class="text-center mb-8">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">
            Side-by-Side <span class="text-salwah-gold">Package Comparison</span>
          </h2>
          <p class="mt-2 text-sm text-gray-300">
            Compare inclusions across Silver, Gold, and Platinum at a glance.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full min-w-[640px] text-left border-collapse">
            <thead>
              <tr class="border-b border-salwah-gold/30 text-sm sm:text-base">
                <th class="py-3.5 px-4 font-serif text-white">Inclusion</th>
                <th class="py-3.5 px-4 font-serif text-white text-center">Silver</th>
                <th class="py-3.5 px-4 font-serif text-salwah-gold text-center">Gold</th>
                <th class="py-3.5 px-4 font-serif text-white text-center">Platinum</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-sm">
              {
                PACKAGE_COMPARISON.map((row) => (
                  <tr class="hover:bg-white/[0.02]">
                    <td class="py-3.5 px-4 font-medium text-gray-200">{row.feature}</td>
                    <td class="py-3.5 px-4 text-center text-gray-300">
                      {row.silver === true ? (
                        <span class="text-emerald-400 font-bold" aria-label="Included">&#10003;</span>
                      ) : row.silver === false ? (
                        <span class="text-gray-600" aria-label="Not included">&mdash;</span>
                      ) : (
                        row.silver
                      )}
                    </td>
                    <td class="py-3.5 px-4 text-center font-semibold text-salwah-gold">
                      {row.gold === true ? (
                        <span class="text-emerald-400 font-bold" aria-label="Included">&#10003;</span>
                      ) : row.gold === false ? (
                        <span class="text-gray-600" aria-label="Not included">&mdash;</span>
                      ) : (
                        row.gold
                      )}
                    </td>
                    <td class="py-3.5 px-4 text-center text-gray-300">
                      {row.platinum === true ? (
                        <span class="text-emerald-400 font-bold" aria-label="Included">&#10003;</span>
                      ) : row.platinum === false ? (
                        <span class="text-gray-600" aria-label="Not included">&mdash;</span>
                      ) : (
                        row.platinum
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="mt-6 text-center text-sm text-gray-300">
          Want to pick exact dishes and export a PDF summary? Try our free{' '}
          <a href="/resources/quote-builder" class="text-salwah-gold font-semibold underline hover:no-underline">
            Interactive Quote Builder
          </a>{' '}
          or{' '}
          <a href="/resources/budget-calculator" class="text-salwah-gold font-semibold underline hover:no-underline">
            Wedding Budget Calculator
          </a>.
        </div>
      </div>
    </div>
  </section>

  <!-- Inline Proposal Form -->
  <section id="quote-form" class="py-16 bg-salwah-surface border-t border-white/5">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteForm
        client:visible
        variant="compact"
        sourcePage="Packages Page"
        heading="Request a Tailored Package Proposal"
        subheading="Share your guest count & event date for an exact written quote — zero hidden fees."
      />
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <CtaBanner primaryHref="/menu" primaryLabel="Explore Full Halal Menu" />
</BaseLayout>
