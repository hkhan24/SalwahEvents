---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';

import headerStage from '@/assets/images/header-stage-decor.png';
import menuMains from '@/assets/images/menu-mains.png';
import menuStarters from '@/assets/images/menu-starters.png';

import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'Asian Wedding Catering', href: '/services/asian-wedding-catering' },
  { name: 'North & West London Halal Wedding Catering' },
];

const quickFacts = [
  { label: 'Kitchen HQ', value: 'Unit 7 Landmark Commercial Centre, Edmonton, North London (N18 1UB)' },
  { label: 'Starting Price', value: 'From £30pp (Silver) • £45pp (Gold) • Platinum All-Inclusive from £17,500' },
  { label: 'Guest Capacity', value: '50 to 1,000+ guests (Banqueting Suites, Hotels & Estate Marquees)' },
  { label: 'North London Areas', value: 'Edmonton, Enfield, Tottenham, Palmers Green, Southgate, Barnet & Finchley' },
  { label: 'West & NW Areas', value: 'Harrow, Wembley, Hendon, Stanmore, Ealing, Southall, Hounslow & Brentford' },
  { label: 'Featured Venues', value: 'Meridian Grand (N18), Ariana Banqueting Hall, Osterley Park & Syon Park' },
];

const regionalBlocks = [
  {
    area: 'North London (Minutes From Our N18 Kitchen)',
    locations: ['Edmonton & Meridian Grand (N18)', 'Enfield, Winchmore Hill & Southgate', 'Tottenham, Wood Green & Palmers Green', 'Barnet, Finchley & Hendon'],
    copy: 'Based directly in Edmonton N18, our catering brigade reaches Meridian Grand and Ariana Banqueting Hall within minutes — delivering unmatched freshness, rapid kitchen replenishment, and seamless load-in for both intimate Nikahs and 900-guest receptions.',
  },
  {
    area: 'West & North-West London',
    locations: ['Harrow, Stanmore & Pinner', 'Wembley & Brent', 'Ealing, Southall & Greenford', 'Isleworth, Brentford, Osterley & Syon Park'],
    copy: 'Hosting a grand marquee at Osterley Park, a glasshouse celebration at Syon Park, or a hotel ballroom banquet in Wembley or Harrow? We bring full mobile finishing equipment, fine crockery, glassware, uniformed staff, and luxury stage decoration.',
  },
];

const faqs: FaqItem[] = [
  {
    question: 'Where is Salwah Events kitchen located in North London?',
    answer:
      'Our dedicated 100% HMC Certified Halal commercial kitchen and consultation office is at Unit 7 Landmark Commercial Centre, 7 Commercial Road, Edmonton, London, N18 1UB — just off the A406 North Circular and minutes from Meridian Grand.',
  },
  {
    question: 'Do you cater at Meridian Grand, Ariana Banqueting Hall, and West London venues?',
    answer:
      'Yes! We regularly cater across North and West London, including Meridian Grand, Ariana Banqueting Hall, Osterley Park & House, Syon Park, and leading hotel ballrooms in Wembley, Harrow, Barnet, and Ealing.',
  },
  {
    question: 'Can we book a menu consultation at your Edmonton London location?',
    answer:
      'Yes! Contact us by phone (07359 337887), WhatsApp, or our quote form to schedule a personal menu consultation and food sampling session with our culinary team.',
  },
  {
    question: 'What cuisines do you offer for North and West London weddings?',
    answer:
      'We serve 100% HMC Certified Halal Pakistani, Indian, and Bengali wedding menus — including chargrilled tandoori starters, live chaat counters, lamb karahi, slow-cooked nihari, kacchi biryani, paneer specialities, mocktails, and karak chai.',
  },
];

const schemas = [
  buildBreadcrumbSchema(breadcrumbs),
  buildServiceSchema({
    name: 'North & West London Halal Asian Wedding Catering (Edmonton, Enfield, Harrow, Wembley & Southall)',
    serviceType: 'North & West London Halal Wedding Catering & Stage Decor',
    description:
      '100% HMC Certified Halal Asian wedding catering and stage decoration from our Edmonton N18 kitchen serving North & West London: Enfield, Barnet, Finchley, Harrow, Wembley, Southall & Ealing from £30pp.',
    url: '/halal-wedding-catering-north-west-london',
    areaServed: ['North London', 'West London', 'Edmonton', 'Enfield', 'Barnet', 'Finchley', 'Harrow', 'Wembley', 'Southall', 'Ealing', 'Hounslow'],
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title="North & West London Halal Wedding Catering | Edmonton, Harrow & Wembley | Salwah Events"
  description="100% HMC Certified Halal Asian wedding caterers based in Edmonton N18 serving North & West London (Enfield, Barnet, Harrow, Wembley, Southall, Ealing & Meridian Grand) from £30pp."
  canonicalPath="/halal-wedding-catering-north-west-london"
  schemas={schemas}
>
  <PageHero
    eyebrow="Edmonton N18 Kitchen HQ • North, North-West & West London"
    title="North & West London"
    highlight="Halal Wedding Catering"
    subtitle="Cooked fresh in our dedicated Edmonton (N18) 100% HMC Halal kitchen and delivered piping-hot across Meridian Grand, Enfield, Barnet, Harrow, Wembley, Southall, Osterley Park, and Syon Park — from £30pp."
    image={headerStage}
    imageAlt="Luxury North and West London wedding ballroom stage and catering setup"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="#quote-form"
    primaryCtaLabel="Check North / West London Dates"
  />

  <section class="py-14 sm:py-16 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-10">
          <QuickFactsBox
            heading="North & West London Catering — Quick Facts"
            summary="Local Edmonton (N18) culinary headquarters serving North London banqueting halls and West London luxury estates with full HMC Halal catering and bespoke stage design."
            facts={quickFacts}
          />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
              regionalBlocks.map((block) => (
                <div class="luxury-card rounded-2xl p-6 space-y-4">
                  <h2 class="font-serif text-2xl font-bold text-salwah-gold">{block.area}</h2>
                  <p class="text-sm text-gray-300 leading-relaxed">{block.copy}</p>
                  <ul class="space-y-1.5 text-sm text-gray-200 pt-2 border-t border-white/10">
                    {block.locations.map((loc) => (
                      <li class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-salwah-gold shrink-0" />
                        <span>{loc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden border border-salwah-gold/25">
              <Picture
                src={menuMains}
                alt="Slow-cooked Halal lamb karahi, butter chicken and beef bhuna for North and West London weddings"
                widths={[480, 800]}
                formats={['webp']}
                fallbackFormat="webp"
                quality={80}
                loading="lazy"
                class="h-56 w-full object-cover"
              />
            </div>
            <div class="rounded-2xl overflow-hidden border border-salwah-gold/25">
              <Picture
                src={menuStarters}
                alt="Chargrilled Halal tandoori starters and seekh kebabs for London weddings"
                widths={[480, 800]}
                formats={['webp']}
                fallbackFormat="webp"
                quality={80}
                loading="lazy"
                class="h-56 w-full object-cover"
              />
            </div>
          </div>

          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-salwah-gold prose-a:text-salwah-gold">
            <h2>Direct North Circular Proximity &amp; Dry-Hire Expertise</h2>
            <p>
              Whether you are hosting an elegant Walima at Meridian Grand just around the corner from our N18
              kitchen, a vibrant Punjabi or Gujarati-inspired Halal reception in Harrow or Wembley, or a grand
              summer marquee at Syon Park, Salwah Events brings white-glove culinary discipline, spotless hygiene,
              and cohesive <a href="/services/wedding-stage-decoration">wedding stage decoration</a>.
            </p>
            <p>
              Also comparing venues in <a href="/halal-wedding-catering-east-london">East London</a> or dry-hire
              estates? See our <a href="/dry-hire-asian-wedding-catering-london">Dry-Hire &amp; Hotel Catering</a>{' '}
              guide or browse our full <a href="/services/venues-locations">Partner Venues Directory</a>.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-5 lg:sticky lg:top-28 space-y-6" id="quote-form">
          <QuoteForm
            client:visible
            variant="compact"
            sourcePage="North & West London LP"
            defaultService="Both Catering & Stage Decor"
            heading="Get a North / West London Quote"
            subheading="Share your venue, date & guest count — book a menu consultation with our Edmonton N18 team."
          />
        </aside>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} heading="North &amp; West London Catering FAQs" />
  <CtaBanner
    title="Hosting a Wedding in"
    highlight="North or West London?"
    primaryHref="#quote-form"
    primaryLabel="Request Your Free Quote"
  />
</BaseLayout>
