---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';

import headerAbout from '@/assets/images/header-about.png';
import aboutTable from '@/assets/images/about-table.jpg';
import aboutTeam from '@/assets/images/about-team.jpg';

import { SITE } from '@/data/site';
import { buildBreadcrumbSchema, type BreadcrumbItem } from '@/lib/schema';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  { name: 'About Us' },
];

const values = [
  {
    title: 'Quality Without Shortcuts',
    description:
      'From the freshness of our spices and exclusively HMC-certified Halal meat and poultry to the finishing touches on your stage, we refuse to cut corners.',
  },
  {
    title: 'Cultural & Religious Respect',
    description:
      'We create welcoming, Halal-centred celebrations where every guest — from elders to younger family members — feels honoured, comfortable, and well looked after.',
  },
  {
    title: 'Calm, Reliable Professionalism',
    description:
      'Clear per-head pricing from £25pp, punctual kitchen logistics, and attentive waiting staff ensure your celebration runs smoothly while you stay present with loved ones.',
  },
];
---

<BaseLayout
  title="About Salwah Events | Family-Led Asian Wedding Specialists London"
  description="Meet Salwah Events and Catering (Salwah Events Ltd) — a family-led London Asian wedding catering, stage decor, and event management team serving Greater London, Essex & Kent."
  canonicalPath="/about"
  schemas={[buildBreadcrumbSchema(breadcrumbs)]}
>
  <PageHero
    eyebrow="Family-Led Excellence • Edmonton, London"
    title="Your Trusted Asian"
    highlight="Event Partner"
    subtitle="Founded to give UK Muslim and South Asian families a genuinely reliable, luxury Halal catering and event experience across London, Essex, and Kent."
    image={headerAbout}
    imageAlt="Salwah Events chefs preparing fresh Halal wedding cuisine in London"
    breadcrumbs={breadcrumbs}
    primaryCtaHref="/contact#quote-form"
    primaryCtaLabel="Book a Consultation"
  />

  <section class="py-16 sm:py-20 bg-salwah-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-salwah-gold">Our Story</p>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
            Built on <span class="gold-gradient-text italic font-semibold">Halal Excellence &amp; Hospitality</span>
          </h2>
          <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
            <strong>{SITE.businessName}</strong> was born from a simple conviction: UK Muslim and South
            Asian families deserve a wedding and event specialist who genuinely understands the cultural
            and religious nuances of our celebrations — without ever compromising on luxury, presentation,
            or reliability.
          </p>
          <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
            As a family-led team operating from our dedicated Halal kitchen in Edmonton, North
            London, we pour personal care into every wedding, Nikah, Walima, Aqiqah, private
            celebration, and charity or corporate gala — catering gatherings from 50 to 1,000+
            guests across Greater London, Essex, and Kent.
          </p>
        </div>

        <div class="rounded-2xl overflow-hidden border border-salwah-gold/25">
          <Picture
            src={aboutTable}
            alt="Candlelit wedding reception table setting styled for a London celebration"
            widths={[480, 800]}
            sizes="(max-width: 1024px) 100vw, 48vw"
            formats={['webp']}
            fallbackFormat="webp"
            quality={80}
            loading="lazy"
            class="w-full h-80 sm:h-96 object-cover"
          />
        </div>
      </div>

      <!-- Core Values -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">
            Our Core <span class="gold-gradient-text italic font-semibold">Values</span>
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
          {
            values.map((val, idx) => (
              <div class="luxury-card rounded-2xl p-7">
                <span class="font-serif text-3xl font-bold text-salwah-gold/45">0{idx + 1}</span>
                <h3 class="mt-2 font-serif text-xl font-bold text-white">{val.title}</h3>
                <p class="mt-3 text-sm sm:text-base text-gray-300 leading-relaxed">{val.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Professional Team -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="rounded-2xl overflow-hidden border border-salwah-gold/25 order-2 lg:order-1">
          <Picture
            src={aboutTeam}
            alt="Uniformed Salwah Events hospitality servers carrying steaming starter platters across a candlelit London wedding ballroom"
            widths={[480, 800]}
            sizes="(max-width: 1024px) 100vw, 48vw"
            formats={['webp']}
            fallbackFormat="webp"
            quality={80}
            loading="lazy"
            class="w-full h-80 sm:h-96 object-cover"
          />
        </div>

        <div class="space-y-5 order-1 lg:order-2">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-salwah-gold">Our Team</p>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
            Chefs, Designers &amp; <span class="gold-gradient-text italic font-semibold">Event Planners</span>
          </h2>
          <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
            Behind every Salwah celebration is an experienced collective: culinary specialists dedicated
            to authentic Bengali, Pakistani, and Indian cooking; stage and floral designers who turn
            blank halls into warm, memorable rooms; and calm floor supervisors who keep every course
            and milestone right on schedule.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <a href="/services/asian-wedding-catering" class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-bold whitespace-nowrap">
              Explore Catering
            </a>
            <a href="/services/wedding-stage-decoration" class="btn-luxury-outline inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold whitespace-nowrap">
              Explore Stage Decor
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Meet the Team Behind"
    highlight="Your Celebration"
    subtitle="Tell us your date, guest count, and what matters most to your family — whether Halal catering, bespoke stage decor, or complete wedding management."
    primaryHref="/contact#quote-form"
    primaryLabel="Book a Free Consultation"
  />
</BaseLayout>
