---
import type { BreadcrumbItem } from '@/lib/schema';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs sm:text-sm text-gray-400">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((item, idx) => (
        <li class="inline-flex items-center gap-1.5">
          {idx > 0 && <span class="text-salwah-gold/50" aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} class="hover:text-salwah-gold transition">
              {item.name}
            </a>
          ) : (
            <span class="text-salwah-gold font-medium" aria-current="page">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
