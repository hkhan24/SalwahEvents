---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuickFactsBox from '@/components/QuickFactsBox.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import QuoteForm from '@/components/QuoteForm';
import InstantQuoteEstimator from '@/components/InstantQuoteEstimator';
import WeddingExperienceShowcase, { type ShowcaseSlide } from '@/components/WeddingExperienceShowcase';

import heroCouple from '@/assets/images/hero-couple.jpg';
import serviceCatering from '@/assets/images/home-service-catering.jpg';
import serviceStage from '@/assets/images/home-service-stage.jpg';
import servicePlanning from '@/assets/images/home-service-planning.jpg';
import menuBiryani from '@/assets/images/menu-biryani.png';
import menuMains from '@/assets/images/menu-mains.png';
import menuStarters from '@/assets/images/menu-starters.png';
import menuDesserts from '@/assets/images/menu-desserts.png';
import galleryMocktails from '@/assets/images/gallery-catering-platters.png';
import galleryDessertDisplay from '@/assets/images/gallery-dessert-display.png';
import galleryStageFloral from '@/assets/images/gallery-stage-floral.jpg';
import headerAsianCatering from '@/assets/images/header-asian-catering.png';

import { SITE } from '@/data/site';
import { PACKAGES } from '@/data/packages';
import { PARTNER_VENUE_NAMES } from '@/data/venues';
import { TESTIMONIALS } from '@/data/testimonials';
import {
  buildFaqSchema,
  buildOfferCatalogSchema,
  buildServiceSchema,
  type FaqItem,
} from '@/lib/schema';

const [optFeast, optStage, optLounge, optDesserts] = await Promise.all([
  getImage({ src: headerAsianCatering, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: serviceStage, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: galleryMocktails, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: galleryDessertDisplay, width: 1000, format: 'webp', quality: 80 }),
]);

const showcaseSlides: ShowcaseSlide[] = [
  {
    id: 'royal-feast',
    tabLabel: '01 • The Wedding Feast',
    eyebrow: 'HMC-Certified Halal Banquets',
    title: 'Authentic Flavours Served Piping Hot to Every Table',
    description:
      'At an Asian wedding, guests remember the food first. From fragrant Lamb Kacchi Biryani and slow-cooked Beef Kala Bhuna to chargrilled Chicken Malai Tikka and Lamb Karahi, every dish is cooked fresh in our London Halal kitchen using exclusively HMC-certified meat and poultry.',
    highlights: [
      'Authentic Bengali, Pakistani, and Indian regional recipes',
      'Flexible grand buffet, family-style table service, or plated dining',
      'Full crockery, cutlery, and uniformed waiting staff included',
    ],
    imageSrc: optFeast.src,
    imageAlt: 'Uniformed Salwah Events servers presenting steaming copper bowls of saffron biryani and curries to guests at a candlelit London Asian wedding banquet with the bride and groom on stage behind',
    serviceTarget: 'Wedding Catering',
    ctaLabel: 'Build My Wedding Menu',
    href: '/menu',
  },
  {
    id: 'dream-stage',
    tabLabel: '02 • Bespoke Wedding Stages',
    eyebrow: 'Custom Ballroom & Ceremony Design',
    title: 'Stages Styled Around Your Venue, Outfits, and Vision',
    description:
      'Your stage frames every portrait and every entrance. Rather than rolling out recycled templates, our designers build custom floral walls, sculpted arches, serene Nikah backdrops, and vibrant Mehndi stages proportioned specifically to your hall.',
    highlights: [
      'Fresh blooms, luxury silk florals, or bespoke hybrid installations',
      'Coordinated sweetheart seating, walkways, table centrepieces & uplighting',
      'One crew handling stage setup alongside your catering run-sheet',
    ],
    imageSrc: optStage.src,
    imageAlt: 'Bespoke ivory and gold floral Asian wedding stage decoration with baroque sofa',
    serviceTarget: 'Stage Decoration',
    ctaLabel: 'Design My Wedding Stage',
    href: '/services/wedding-stage-decoration',
  },
  {
    id: 'welcome-hospitality',
    tabLabel: '03 • Welcome Drinks & Canapés',
    eyebrow: 'Included in Gold & Platinum Packages',
    title: 'Warm Hospitality From the Moment Guests Arrive',
    description:
      'Set the tone before dinner even begins. Greet your family and friends with refreshing fruit mocktails, handmade canapés, and optional spiced chai stations so guests feel welcomed while bridal portraits wrap up.',
    highlights: [
      'Refreshing welcome drinks and freshly prepared canapés on arrival',
      'Optional traditional chai and refreshment stations for evening receptions',
      'Ideal for Mehndis, Nikah receptions, Aqiqahs, and grand Walimas',
    ],
    imageSrc: optLounge.src,
    imageAlt: 'Welcome mocktails and freshly poured spiced chai served at a London wedding',
    serviceTarget: 'Catering & Stage',
    ctaLabel: 'See Gold & Platinum Inclusions',
    href: '/packages',
  },
  {
    id: 'dessert-stalls',
    tabLabel: '04 • Desserts & Paan Stalls',
    eyebrow: 'The Finale Guests Crowd Around',
    title: 'Warm Traditional Sweets & Live Dessert or Paan Stalls',
    description:
      'Close the evening on a high note with warm Gulab Jamun, Kalajam, Gajar Halwa, and Baklava served with creamy ice cream — or add a live Dessert or Paan Stall that keeps both children and elders coming back for seconds.',
    highlights: [
      'Traditional Firni, Milk Cake, Strawberry Cheesecake & warm mithai',
      'Live Dessert or Paan Stall included inside our Platinum Package',
      'Dedicated vegetarian, vegan, and allergen-aware options available',
    ],
    imageSrc: optDesserts.src,
    imageAlt: 'Luxury tiered South Asian wedding dessert display featuring baklava and warm sweets',
    serviceTarget: 'Wedding Catering',
    ctaLabel: 'Add a Dessert or Paan Stall',
    href: '/menu#desserts',
  },
];

const homeFaqs: FaqItem[] = [
  {
    question: 'How much does Asian wedding catering cost per person in London?',
    answer:
      'Our packages start from £25 per person for the Silver Package (3 starters, 4 mains, pilau rice, plain rice or naan, 1 dessert, crockery, cutlery, and waiting staff) and £40 per person for our most popular Gold Package (adding welcome drinks, canapés, 4 starters including fish, 4 premium mains, biryani or rice, 2 desserts, glassware, and a floor supervisor). Our all-inclusive Platinum Package starts from £17,500 for 200 guests.',
  },
  {
    question: 'Is all of your food 100% HMC Certified Halal?',
    answer:
      'Yes. We are a dedicated Halal caterer and source all meat and poultry exclusively from HMC-certified suppliers. Our kitchens operate under strict Halal procedures so you and your guests can dine with complete peace of mind.',
  },
  {
    question: 'How many guests can Salwah Events cater for?',
    answer:
      'We cater smoothly for intimate Nikah lunches, Aqiqahs, and Mehndis starting from 50 guests right up to grand banqueting hall weddings and Walimas for 1,000+ guests across Greater London, Essex, and Kent.',
  },
  {
    question: 'Which South Asian cuisines do you offer?',
    answer:
      'Our chefs specialise in authentic Bengali (Bangladeshi), Pakistani, and Indian cuisine — from Lamb Kacchi Biryani, Beef Kala Bhuna, and Chicken Roast to Lamb Bhuna, Chicken Karahi, Chapli Kebabs, Papri Chaat, and warm Gulab Jamun. Mixed-heritage menus can also be tailored to suit both families.',
  },
  {
    question: 'Can we arrange a menu consultation and food sampling before booking?',
    answer:
      'Yes. Get in touch by phone, WhatsApp, or our quote form to arrange a complimentary consultation and food sampling so you and your family can agree on spice levels, dishes, and presentation before confirming your date.',
  },
  {
    question: 'Do you cater at dry-hire venues, hotels, and marquees across London, Essex, and Kent?',
    answer:
      'Yes. Alongside preferred London banqueting halls such as The City Pavilion, Meridian Grand, The Willows, and Mayfair Venue, we bring full catering equipment, crockery, glassware, and uniformed staff to dry-hire estates, hotels, and marquees across London, Essex, and Kent.',
  },
];

const cuisineAndCeremonyHubs = [
  {
    title: 'Bengali Wedding Catering',
    tag: 'Bangladeshi & Sylheti Classics',
    href: '/bengali-wedding-catering-london',
    blurb: 'Lamb Kacchi Biryani, Beef Kala Bhuna, Beef Rezala, Chicken Roast, Fish Masala, and warm Kalajam.',
    image: menuBiryani,
    alt: 'Traditional Bengali Lamb Kacchi Biryani wedding catering in London',
  },
  {
    title: 'Pakistani Wedding Catering',
    tag: 'Nikah, Mehndi, Baraat & Walima',
    href: '/pakistani-wedding-catering-london',
    blurb: 'Distinct menus for every function — Chapli Kebabs, Chicken Karahi, slow-cooked Nihari, Dum Biryani & Gajar Halwa.',
    image: menuMains,
    alt: 'Authentic Pakistani wedding catering curries and grills in London',
  },
  {
    title: 'Indian Wedding Catering',
    tag: 'Halal & Dedicated Vegetarian',
    href: '/indian-wedding-catering-london',
    blurb: 'Tandoori starters, Papri Chaat, Chicken Butter Makhni, Paneer specialities, Daal Makhni & warm Gulab Jamun.',
    image: menuStarters,
    alt: 'Halal Indian wedding starters and tandoori catering in London',
  },
  {
    title: 'Nikah & Walima Catering',
    tag: '50 to 1,000+ Guests',
    href: '/nikah-walima-catering-london',
    blurb: 'Dignified Nikah lunches, floral partitions, segregated service on request, and grand Walima banquets.',
    image: heroCouple,
    alt: 'Nikah and Walima Asian wedding catering in London',
  },
  {
    title: 'Mehndi & Gaye Holud',
    tag: 'Vibrant Pre-Wedding Nights',
    href: '/mehndi-gaye-holud-catering-london',
    blurb: 'Street-style chaat, sizzling charcoal kebabs, colourful welcome drinks, spiced chai & festive stage styling.',
    image: galleryMocktails,
    alt: 'Mehndi and Gaye Holud catering with welcome drinks and spiced chai in London',
  },
  {
    title: 'Dry-Hire, Hotels & Marquees',
    tag: 'Complete Mobile Service',
    href: '/dry-hire-asian-wedding-catering-london',
    blurb: 'Full finishing equipment, fine crockery, glassware & uniformed waiting staff for dry-hire halls, hotels & estates.',
    image: servicePlanning,
    alt: 'Dry-hire Asian wedding banquet tablescape in London',
  },
];

const regionalHubs = [
  {
    region: 'East London',
    towns: 'Ilford • Romford • Newham • Tower Hamlets • Redbridge • Barking • Wanstead • Stratford',
    href: '/halal-wedding-catering-east-london',
    blurb: 'Preferred caterers at The City Pavilion and experienced across The Willows, Mayfair Venue, The Royal Regency, Palm Tree & Oasis.',
  },
  {
    region: 'North & West London',
    towns: 'Edmonton (N18) • Enfield • Barnet • Finchley • Harrow • Wembley • Southall • Ealing',
    href: '/halal-wedding-catering-north-west-london',
    blurb: 'Minutes from Meridian Grand and Ariana Banqueting Hall, with full dry-hire service for Osterley Park & Syon Park.',
  },
  {
    region: 'Essex & Kent',
    towns: 'Chigwell • Loughton • Brentwood • Chelmsford • Dartford • Gravesend • Sevenoaks • Maidstone',
    href: '/halal-wedding-catering-essex-kent',
    blurb: 'Insulated fleets and mobile finishing kitchens bringing freshly cooked London Halal banquets to country houses and marquees.',
  },
];

const coreServices = [
  {
    title: 'Asian Wedding Catering',
    href: '/services/asian-wedding-catering',
    ctaLabel: 'Explore Wedding Catering',
    description:
      'Authentic Bengali, Pakistani, and Indian cuisine prepared with HMC-certified Halal meat and poultry — with uniformed waiting staff, crockery, and cutlery included.',
    image: serviceCatering,
    alt: 'Halal Asian wedding catering table service in London',
  },
  {
    title: 'Wedding Stage Decoration',
    href: '/services/wedding-stage-decoration',
    ctaLabel: 'See Stage Designs',
    description:
      'Custom floral backdrops, Nikah partitions, vibrant Mehndi stages, Mandaps, couple seating, table centrepieces, and ambient lighting tailored to your room.',
    image: serviceStage,
    alt: 'Bespoke floral Asian wedding stage decoration in London',
  },
  {
    title: 'Event Management & Planning',
    href: '/services/event-management-planning',
    ctaLabel: 'See How We Plan',
    description:
      'Master run-sheets, supplier coordination, venue liaison, and dedicated on-the-day direction so you and your parents stay present with your guests.',
    image: servicePlanning,
    alt: 'Luxury Asian wedding planning and on-the-day event management',
  },
];

const weddingJourney = [
  {
    step: '01',
    title: 'Share Your Date & Vision',
    detail:
      'Tell us your date, approximate guest count, and preferred cuisine. We reply promptly with clear per-head pricing from £25pp and honest advice.',
  },
  {
    step: '02',
    title: 'Menu Consultation & Sampling',
    detail:
      'Meet our team to fine-tune your menu, adjust spice levels for elders and younger guests, and review bespoke stage design concepts.',
  },
  {
    step: '03',
    title: 'Venue Walkthrough & Run-Sheet',
    detail:
      'We coordinate directly with your banqueting hall or dry-hire estate on kitchen access, load-in timings, and exact serving schedules.',
  },
  {
    step: '04',
    title: 'Calm Execution on the Day',
    detail:
      'Enjoy every moment with your family while our chefs serve hot, generous courses and our floor team keeps the entire evening running on time.',
  },
];

const quickFacts = [
  { label: 'Starting Price', value: 'From £25 per person (Silver) • £40pp (Gold) • From £17,500 (Platinum, 200 guests)' },
  { label: 'Guest Capacity', value: '50 to 1,000+ guests (Weddings, Nikah, Walima, Mehndi, Aqiqahs & Galas)' },
  { label: 'Halal Standard', value: '100% HMC Certified Halal Meat & Poultry • Dedicated Halal Kitchen' },
  { label: 'Cuisines Offered', value: 'Bengali (Bangladeshi), Pakistani & Indian — Plus Dedicated Vegetarian & Vegan' },
  { label: 'Service Styles', value: 'Grand Buffet, Family-Style Table Service, Formal Plated Dining & Live Stalls' },
  { label: 'Areas Covered', value: 'Greater London (East, North, West & South), Essex & Kent' },
];

const schemas = [
  buildServiceSchema({
    name: 'Halal Asian Wedding Catering & Event Services',
    serviceType: 'Halal Wedding Catering, Stage Decoration & Event Management',
    description:
      'Family-led 100% HMC Certified Halal Asian wedding catering (Bengali, Pakistani & Indian) and bespoke wedding stage decoration across Greater London, Essex, and Kent from £25pp.',
    url: '/',
  }),
  buildOfferCatalogSchema(),
  buildFaqSchema(homeFaqs),
];
---

<BaseLayout
  title="Luxury Asian Wedding Catering London & Stage Decor | Salwah Events"
  description="Family-led 100% HMC Certified Halal Asian wedding catering (Bengali, Pakistani & Indian), bespoke stage decor & event planning in London, Essex & Kent. Packages from £25pp for 50–1,000+ guests."
  canonicalPath="/"
  schemas={schemas}
>
  <!-- 1. Editorial Split Luxury Hero (Couple 100% Visible & Unobstructed) -->
  <section class="relative overflow-hidden obsidian-glow border-b border-salwah-gold/25">
    <div
      class="pointer-events-none absolute -top-24 right-0 h-[420px] w-[420px] rounded-full bg-salwah-gold/10 blur-[120px]"
      aria-hidden="true"
    />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-9 sm:py-12 lg:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Sharp Editorial Copy & High-Intent CTAs -->
        <div class="lg:col-span-6 text-left">
          <p class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.22em] text-salwah-gold mb-3.5">
            <span class="h-px w-6 bg-salwah-gold/75 shrink-0" aria-hidden="true" />
            London &middot; Essex &middot; Kent &middot; Family-Led Specialists
          </p>
          <h1 class="font-serif text-4xl sm:text-5xl xl:text-[3.45rem] font-bold tracking-tight text-white leading-[1.06]">
            Asian Wedding Catering &amp; <span class="gold-gradient-text italic font-semibold">Bespoke Stage Decor</span>
          </h1>
          <p class="mt-4 text-base sm:text-lg text-gray-200/95 max-w-xl leading-relaxed">
            Authentic Bengali, Pakistani, and Indian wedding catering paired with bespoke floral
            stage design — delivered by one dedicated London team for{' '}
            <strong>50 to 1,000+ guests</strong>, with packages starting from{' '}
            <strong>£25 per person</strong>.
          </p>

          <div class="mt-7 flex flex-col sm:flex-row sm:flex-nowrap gap-2.5">
            <a
              href="#quote-form"
              class="btn-luxury-gold inline-flex items-center justify-center rounded-xl px-5 py-3.5 text-sm font-bold whitespace-nowrap"
            >
              Check Date &amp; Pricing
            </a>
            <a
              href="#instant-estimator"
              class="btn-luxury-outline inline-flex items-center justify-center rounded-xl px-4.5 py-3.5 text-sm font-semibold whitespace-nowrap"
            >
              Estimate Cost
            </a>
            <a
              href={SITE.whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="hidden sm:inline-flex btn-luxury-whatsapp items-center justify-center gap-2 rounded-xl px-4.5 py-3.5 text-sm font-semibold whitespace-nowrap"
            >
              <svg class="h-4 w-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
              </svg>
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        <!-- Right: Full Unobstructed Radiant Couple Portrait -->
        <div class="lg:col-span-6">
          <div class="relative rounded-3xl editorial-frame overflow-hidden bg-black aspect-[4/3] sm:aspect-[16/11] lg:aspect-[5/4] shadow-2xl">
            <Picture
              src={heroCouple}
              alt="Joyful South Asian bride and groom celebrating inside a candlelit luxury London ballroom"
              widths={[640, 1280]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              formats={['webp']}
              fallbackFormat="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="h-full w-full object-cover object-[50%_20%]"
            />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
            <div class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full border border-salwah-gold/45 bg-black/75 backdrop-blur-md px-3.5 py-1.5 text-xs font-semibold text-salwah-gold">
                Bespoke Banquets &amp; Floral Stages
              </span>
              <span class="rounded-full border border-white/20 bg-black/75 backdrop-blur-md px-3.5 py-1.5 text-xs font-medium text-gray-100">
                Nikah &middot; Mehndi &middot; Walima &middot; Receptions
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Architectural 4-Pillar Credentials Bar -->
  <section class="bg-[#090a0f] border-b border-salwah-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0 lg:divide-x lg:divide-salwah-gold/20 text-center">
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">100% HMC</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Certified Halal Meat &amp; Poultry</p>
        </div>
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">From £25pp</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Clear Per-Head Packages</p>
        </div>
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">50 – 1,000+</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Intimate Nikahs to Grand Walimas</p>
        </div>
        <div class="px-3">
          <p class="font-serif text-2xl sm:text-3xl font-bold gold-gradient-text">5.0★ Rated</p>
          <p class="mt-1 text-xs sm:text-sm text-gray-300">Trusted by UK Families</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Interactive Wedding Experience Showcase -->
  <section class="py-18 sm:py-24 obsidian-glow" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-salwah-gold mb-2.5">
          The Salwah Standard
        </p>
        <div class="ornamental-divider mb-4" aria-hidden="true">
          <span class="ornamental-diamond" />
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
          What Turns a Good Wedding Into <span class="gold-gradient-text italic font-semibold">a Great One</span>
        </h2>
        <p class="mt-4 text-gray-300 text-base sm:text-lg">
          Guests rarely remember spreadsheets. They remember the aroma when dinner opens, the stage behind your portraits, and how warmly every table was looked after.
        </p>
      </div>

      <WeddingExperienceShowcase client:visible slides={showcaseSlides} />
    </div>
  </section>

  <!-- 4. Culinary & Decor Visual Lookbook -->
  <section class="py-18 sm:py-22 velvet-section border-y border-salwah-gold/15" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-salwah-gold mb-2">
            From Our Kitchen &amp; Floral Studio
          </p>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
            Dishes &amp; Stages Built to <span class="gold-gradient-text italic font-semibold">Impress Every Table</span>
          </h2>
        </div>
        <div class="flex items-center gap-5 shrink-0">
          <a href="/menu" class="text-sm font-bold text-salwah-gold hover:underline">
            Explore Full Menu &rarr;
          </a>
          <a href="/gallery" class="text-sm font-semibold text-gray-300 hover:text-salwah-gold transition">
            View Gallery &rarr;
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <a
          href="/menu#rice-biryani"
          class="group md:col-span-7 relative overflow-hidden rounded-2xl editorial-frame min-h-[280px] sm:min-h-[360px]"
        >
          <Picture
            src={menuBiryani}
            alt="Steaming saffron Lamb Kacchi Biryani served in hammered copper deg"
            widths={[480, 800]}
            sizes="(max-width: 768px) 100vw, 58vw"
            formats={['webp']}
            fallbackFormat="webp"
            quality={80}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent p-6 sm:p-7 flex flex-col justify-end">
