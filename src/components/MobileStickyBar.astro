---
import { SITE } from '@/data/site';
---

<div
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 border-t border-salwah-gold/30 bg-[#08090d]/95 backdrop-blur-md px-2.5 py-2 shadow-[0_-8px_30px_rgba(0,0,0,0.75)]"
  role="region"
  aria-label="Quick Contact Actions"
>
  <div class="grid grid-cols-3 gap-2 max-w-lg mx-auto">
    <a
      href={SITE.phoneHref}
      class="flex items-center justify-center gap-1.5 rounded-xl border border-salwah-gold/40 bg-salwah-gold/10 py-2.5 px-2 text-xs font-bold text-salwah-gold active:scale-95 transition"
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span>Call Now</span>
    </a>

    <a
      href={SITE.whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-1.5 rounded-xl bg-[#25D366] py-2.5 px-2 text-xs font-bold text-black active:scale-95 transition"
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.391c1.469.797 3.125 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.344-1.766-.656-3.109-1.344-5.141-4.484-5.297-4.688-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391h.594c.188 0 .453-.078.703.531.266.641.891 2.188.969 2.344.078.156.125.344.016.547-.094.203-.156.344-.313.516-.156.172-.328.391-.469.516-.156.156-.328.328-.141.641.188.313.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.609 1.609.313.156.5.125.688-.078.188-.203.797-.938 1.016-1.25.219-.313.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z" />
      </svg>
      <span>WhatsApp</span>
    </a>

    <a
      href="#quote-form"
      data-sticky-quote-btn
      class="flex items-center justify-center gap-1.5 rounded-xl bg-salwah-gold py-2.5 px-2 text-xs font-bold text-black active:scale-95 transition"
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
        <line x1="16" y1="13" x2="8" y2="13" />
        <line x1="16" y1="17" x2="8" y2="17" />
      </svg>
      <span>Free Quote</span>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    var quoteBtn = document.querySelector('[data-sticky-quote-btn]');
    if (!quoteBtn) return;
    if (!document.getElementById('quote-form')) {
      quoteBtn.setAttribute('href', '/contact#quote-form');
    }
  })();
</script>
